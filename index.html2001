<div class="overlay" id="adminOv" role="dialog" aria-modal="true" aria-label="Admin">
  <div class="modal wide">
    <button class="x" data-close="adminOv" aria-label="Close">✕</button>
    <div id="adminLogin">
      <h2>Admin sign in</h2>
      <p style="color:var(--muted);margin-bottom:16px">Only the Coffee With Stranger team can manage cafés.</p>
      <div class="field" id="a_emailField"><label for="a_email">Admin email</label><input type="email" id="a_email" autocomplete="username"></div>
      <div class="field"><label for="a_pass">Admin password</label><input type="password" id="a_pass" autocomplete="current-password"></div>
      <div class="err" id="adminErr"></div>
      <button class="btn btn-primary" id="adminGo">Sign in</button>
    </div>
    <div id="adminApp" class="hidden">
      <h2>Admin dashboard</h2>
      <div class="stats" id="stats"></div>
      <div class="admin-cols">
        <div>
          <div class="panel">
            <h3>Add a partner café</h3>
            <form id="cafeForm">
              <div class="field"><label for="c_name">Café name</label><input type="text" id="c_name" required></div>
              <div class="grid2">
                <div class="field"><label for="c_area">Area</label><select id="c_area"></select></div>
                <div class="field"><label for="c_phone">Café phone</label><input type="tel" id="c_phone"></div>
              </div>
              <div class="field"><label for="c_addr">Address or landmark</label><input type="text" id="c_addr"></div>
              <div class="grid2">
                <div class="field"><label for="c_owner">Owner or manager</label><input type="text" id="c_owner"></div>
                <div class="field"><label for="c_open">Opens and closes</label><div style="display:flex;gap:8px"><select id="c_open" aria-label="Opening time"></select><select id="c_close" aria-label="Closing time"></select></div></div>
              </div>
              <div class="field"><label for="c_map">Google Maps link (optional)</label><input type="text" id="c_map" placeholder="Paste the café share link from Google Maps"></div>
              <div class="err" id="cafeErr"></div>
              <button class="btn btn-primary" type="submit">Add café and create QR</button>
            </form>
          </div>
          <div class="panel" style="margin-top:20px">
            <h3 id="reqHead">Café requests from owners</h3>
            <div id="reqList"></div>
          </div>
        </div>
        <div>
          <div class="panel">
            <h3>Partner cafés</h3>
            <div id="adminCafes"></div>
          </div>
          <div class="panel" style="margin-top:20px">
            <h3>Members</h3>
            <p style="font-size:14.5px;color:var(--muted);margin-bottom:12px">Download everyone who registered, with phone numbers and emails. Only you can see these.</p>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <button class="btn btn-ghost btn-sm" id="csvBtn">Download members (CSV)</button>
            </div>
          </div>
        </div>
      </div>
      <div class="panel" style="margin-top:20px">
        <h3 id="meetHead">Confirmed meetups</h3>
        <p style="font-size:14.5px;color:var(--muted);margin-bottom:12px">When two people both say OK, they appear here. Each person gets the café, time and map by email automatically (if they gave an email), and by WhatsApp when you tap the WhatsApp button.</p>
        <div id="meetList"></div>
      </div>
      <div class="panel" style="margin-top:20px">
        <h3 id="memHead">Members</h3>
        <p style="font-size:14.5px;color:var(--muted);margin-bottom:12px">Everyone who registered, with phone and email. Only you can see these. People with new matches they have not seen come first. Tap WhatsApp to send them their matches.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:12px">
          <button class="btn btn-primary btn-sm" id="mailAllBtn">Email everyone with new matches</button>
          <label style="font-size:14px;display:flex;gap:6px;align-items:center"><input type="checkbox" id="autoMail"> Send emails automatically while this page is open</label>
        </div>
        <p id="mailState" style="font-size:13.5px;color:var(--muted);margin:0 0 12px"></p>
        <div class="field"><input type="search" id="memberSearch" placeholder="Search by name, phone, area or occupation" aria-label="Search members"></div>
        <div id="memberList"></div>
      </div>
      <div class="admin-note" id="adminNote"></div>
      <div style="margin-top:14px"><button class="btn btn-ghost btn-sm" id="adminOut">Sign out</button></div>
    </div>
  </div>
</div>

<div class="toast" id="toast" role="status"></div>

<script>
/* ============ SETTINGS (edit these) ============ */
const CFG = {
  launchDate: '2026-10-10',        // first free day (YYYY-MM-DD)
  freeDays: 15,                     // free period length
  whatsapp: '919741239979',
  adminUid: 'uBVoyGcGxycBffmaLdSlGwPVykw1',// Firebase Authentication > Users > your admin account > User UID
  emailjs: { serviceId:'service_41p6hvf', templateId:'template_cm5nj8n', publicKey:'mRj4HvDGfPRM3Ga9y' }, // optional: sends emails to members (see SETUP.md)
  posterEmail: 'meetsomeonenew@coffeewithstranger.com', // shown at the bottom of café posters
  notifyUrl: '',                   // optional: Formspree form URL, emails you every new café request
  demoPassword: 'cws-demo'         // used ONLY while Firebase is not connected (demo mode)
};
/* Firebase Console > Project settings > Your apps > Web app > copy the config values here */
const FIREBASE_CONFIG = {
  apiKey: 'AIzaSyCXNHs9MJDio7Lmo2o_JLTs4pgCy5OY4YQ',
  authDomain: 'coffee-with-stranger-ac0ad.firebaseapp.com',
  projectId: 'coffee-with-stranger-ac0ad',
  storageBucket: 'coffee-with-stranger-ac0ad.firebasestorage.app',
  messagingSenderId: '694078156482',
  appId: '1:694078156482:web:5ad395ba47206dd578d55b'
};

/* ============ LISTS ============ */
const CATS = [
  {id:'it',label:'IT employee',icon:'💻'},
  {id:'doctor',label:'Doctor',icon:'🩺'},
  {id:'police',label:'Police',icon:'👮'},
  {id:'lawyer',label:'Lawyer',icon:'⚖️'},
  {id:'business',label:'Business person',icon:'💼'},
  {id:'startup',label:'Startup ideas people',icon:'💡'},
  {id:'realestate',label:'Real estate',icon:'🏢'},
  {id:'film',label:'Film industry',icon:'🎬',sub:'short film artists, directors, models'},
  {id:'construction',label:'Construction',icon:'🏗️'},
  {id:'students',label:'Students',icon:'🎓'},
  {id:'others',label:'Others',icon:'✨'}
];
const FIELDS = ['Technology','Startups','Movies and cinema','Music','Finance','Law','Healthcare','Real estate','Photography','Design and art','Writing','Social work','Politics and policy','Education','Sports'];
const LIKES = ['Travel','Books','Fitness','Food','Gaming','Cricket','Trekking','Podcasts','Fashion','Pets','Dancing','Volunteering','Meditation','Cooking'];
const AREAS = ['Indiranagar','Koramangala','Whitefield','HSR Layout','Jayanagar','JP Nagar','MG Road','Malleshwaram','Electronic City','Marathahalli','BTM Layout','Yelahanka','Other'];

/* ============ DATA LAYER ============
   Connected mode: Firebase Firestore, shared by every visitor and the admin.
   Demo mode (Firebase not configured): this browser's localStorage only. */
const FB_ON = !!(window.firebase && FIREBASE_CONFIG.apiKey && !/^PASTE/.test(FIREBASE_CONFIG.apiKey));
let fs=null, auth=null, onData=function(){};
const cache={users:[],cafes:[],requests:[],pairs:{},contacts:[],notifs:[]};
const synced={users:{},cafes:{},requests:{},pairs:{}};
const stable=o=>JSON.stringify(o,(k,v)=>v&&typeof v==='object'&&!Array.isArray(v)?Object.keys(v).sort().reduce((a,x)=>(a[x]=v[x],a),{}):v);
const lget=(k,d)=>{ try{ const v=localStorage.getItem('cws_'+k); return v?JSON.parse(v):d; }catch(e){ return d; } };
const lset=(k,v)=>{ try{ localStorage.setItem('cws_'+k,JSON.stringify(v)); }catch(e){} };
const DB = {
  ready: Promise.resolve(),
  get(k,d){ if(k==='me'||!FB_ON) return lget(k,d); return cache[k]!==undefined?cache[k]:d; },
  set(k,v){
    if(k==='me'||!FB_ON){ lset(k,v); return Promise.resolve(); }
    cache[k]=v; const jobs=[];
    const put=(id,item)=>{ const data=JSON.parse(JSON.stringify(item)); const st=stable(data); if(synced[k][id]===st) return; synced[k][id]=st; jobs.push(fs.collection(k).doc(id).set(data,{merge:true})); };
    if(Array.isArray(v)){
      v.forEach(it=>put(it.id,it));
      if(k==='cafes'||k==='requests'){ const keep=new Set(v.map(x=>x.id)); Object.keys(synced[k]).forEach(id=>{ if(!keep.has(id)){ delete synced[k][id]; jobs.push(fs.collection(k).doc(id).delete()); } }); }
    } else { Object.keys(v).forEach(id=>put(id,v[id])); }
    return Promise.all(jobs).catch(err=>{ console.error(err); toast(err.code==='permission-denied'?'Could not save: permission denied. Check the Firestore rules.':'Could not save. Check your internet connection.'); });
  },
  start(){
    if(!FB_ON) return;
    firebase.initializeApp(FIREBASE_CONFIG); fs=firebase.firestore(); auth=firebase.auth();
    const watch=k=>new Promise(res=>{
      fs.collection(k).onSnapshot(snap=>{
        const arr=[], obj={}; synced[k]={};
        snap.forEach(d=>{ const data=d.data(); if(k==='pairs') obj[d.id]=data; else { data.id=d.id; arr.push(data); } synced[k][d.id]=stable(data); });
        cache[k]=(k==='pairs')?obj:arr; res(); onData();
      },err=>{ console.error(err); res(); });
    });
    DB.ready=Promise.race([Promise.all([watch('users'),watch('cafes'),watch('pairs')]),new Promise(r=>setTimeout(r,7000))]);
    auth.onAuthStateChanged(user=>{
      adminOn=!!(user && user.uid===CFG.adminUid);
      if(adminOn){ DB.watchRequests(); DB.watchContacts(); DB.watchNotifs(); } else { DB.unwatchRequests(); DB.unwatchContacts(); DB.unwatchNotifs(); }
      if($('#adminOv').classList.contains('on')) showAdmin();
      onData();
    });
  },
  watchRequests(){
    if(DB._rq) return;
    DB._rq=fs.collection('requests').onSnapshot(snap=>{
      const arr=[]; synced.requests={};
      snap.forEach(d=>{ const x=d.data(); x.id=d.id; arr.push(x); synced.requests[d.id]=stable(x); });
      arr.sort((a,b)=>(a.created||0)-(b.created||0)); cache.requests=arr; onData();
    },err=>console.error(err));
  },
  unwatchRequests(){ if(DB._rq){ DB._rq(); DB._rq=null; } cache.requests=[]; synced.requests={}; },
  watchContacts(){
    if(DB._ct) return;
    DB._ct=fs.collection('contacts').onSnapshot(snap=>{ const arr=[]; snap.forEach(d=>arr.push(d.data())); cache.contacts=arr; onData(); },err=>console.error(err));
  },
  watchNotifs(){
    if(DB._nf) return;
    DB._nf=fs.collection('notifs').onSnapshot(snap=>{ const arr=[]; snap.forEach(d=>arr.push(d.data())); cache.notifs=arr; onData(); },err=>console.error(err));
  },
  unwatchNotifs(){ if(DB._nf){ DB._nf(); DB._nf=null; } cache.notifs=[]; },
  unwatchContacts(){ if(DB._ct){ DB._ct(); DB._ct=null; } cache.contacts=[]; },
  async phoneLookup(h){ await DB.ready; if(!FB_ON) return (lget('phones',{}))[h]||null; const d=await fs.collection('phones').doc(h).get(); return d.exists?d.data().uid:null; },
  async phoneSet(h,id){ if(!FB_ON){ const m=lget('phones',{}); m[h]=id; lset('phones',m); return; } await fs.collection('phones').doc(h).set({uid:id}); },
  async contactSet(c){ if(!FB_ON){ const m=lget('contacts',{}); m[c.id]=c; lset('contacts',m); return; } await fs.collection('contacts').doc(c.id).set(c,{merge:true}); },
  async contactsAll(){ if(!FB_ON) return Object.values(lget('contacts',{})); const sn=await fs.collection('contacts').get(); return sn.docs.map(d=>d.data()); }
};
async function phoneHash(p){
  const t='cws:'+p;
  if(window.crypto&&crypto.subtle){ const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(t)); return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join(''); }
  let h=5381; for(const c of t) h=((h<<5)+h+c.charCodeAt(0))|0; return 'L'+(h>>>0).toString(16);
}
function contactMap(){
  const m={};
  if(FB_ON) cache.contacts.forEach(c=>m[c.id]=c); else Object.values(lget('contacts',{})).forEach(c=>m[c.id]=c);
  return m;
}
function notifyOwner(subject,fields){
  if(!CFG.notifyUrl) return;
  fetch(CFG.notifyUrl,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(Object.assign({_subject:subject},fields))}).catch(()=>{});
}
const $ = s => document.querySelector(s);
const esc = s => String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid = () => Math.random().toString(36).slice(2,10);
const catLabel = id => (CATS.find(c=>c.id===id)||{label:'Others'}).label;
const cleanPhone = p => String(p).replace(/\D/g,'').slice(-10);

let toastT;
function toast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('on'); clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove('on'),3600); }
function openOv(id){ $('#'+id).classList.add('on'); document.body.style.overflow='hidden'; }
function closeOv(id){ $('#'+id).classList.remove('on'); if(!document.querySelector('.overlay.on')) document.body.style.overflow=''; }
document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>closeOv(b.dataset.close));
document.querySelectorAll('.overlay').forEach(o=>o.addEventListener('mousedown',e=>{ if(e.target===o) closeOv(o.id); }));
document.addEventListener('keydown',e=>{ if(e.key==='Escape') document.querySelectorAll('.overlay.on').forEach(o=>closeOv(o.id)); });

/* ============ TERMS ============ */
function openTerms(id){
  openOv('termsOv');
  setTimeout(()=>{ const el=id&&document.getElementById(id); if(el&&el.scrollIntoView) el.scrollIntoView({block:'start'}); else { const o=$('#termsOv'); if(o) o.scrollTop=0; } },30);
}
document.addEventListener('click',e=>{ const t=e.target.closest&&e.target.closest('[data-terms]'); if(!t) return; e.preventDefault(); e.stopPropagation(); openTerms(t.dataset.terms); });

/* ============ FREE WEEK BANNER ============ */
(function(){
  document.querySelectorAll('.fd').forEach(e=>{ e.textContent=CFG.freeDays+' days'; });
  const end = new Date(CFG.launchDate+'T00:00:00').getTime() + CFG.freeDays*864e5;
  const left = end - Date.now();
  const el = $('#freeCount');
  if(left>0){
    const d=Math.floor(left/864e5), h=Math.floor(left%864e5/36e5);
    el.textContent = d>0 ? d+' day'+(d>1?'s':'')+' left.' : h+' hours left.';
    const ss=$('#stickerSub'); if(ss) ss.textContent = d>0 ? d+' day'+(d>1?'s':'')+' left' : h+' hours left';
  } else { $('#freeBar').innerHTML='The free launch period has ended. Registration is still open.'; const st=$('#stickerFree'); if(st) st.classList.add('hidden'); }
})();

/* ============ FORM BUILDERS ============ */
function chip(name,val,label,sub,checked){
  return `<label class="chip"><input type="${name==='lookGender'?'radio':'checkbox'}" name="${name}" value="${esc(val)}" ${checked?'checked':''}><span>${label}${sub?` <small>(${esc(sub)})</small>`:''}</span></label>`;
}
let calY=0, calM=0; const calSel=new Set(); let slotSig='';
function calInit(){ const t=new Date(); calY=t.getFullYear(); calM=t.getMonth(); renderCal(); }
function renderCal(){
  const today=new Date(); today.setHours(0,0,0,0);
  const max=new Date(today); max.setDate(max.getDate()+29);
  const first=new Date(calY,calM,1), startDow=first.getDay(), dim=new Date(calY,calM+1,0).getDate();
  const title=first.toLocaleDateString('en-IN',{month:'long',year:'numeric'});
  let cells=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(w=>`<div class="cal-w">${w}</div>`).join('');
  for(let i=0;i<startDow;i++) cells+='<div></div>';
  for(let d=1;d<=dim;d++){
    const dt=new Date(calY,calM,d), iso=isoDate(dt), off=dt<today||dt>max, sel=calSel.has(iso);
    cells+=`<button type="button" class="cal-d${off?' off':''}${sel?' sel':''}${iso===isoDate(today)?' today':''}" data-d="${iso}" ${off?'disabled':''} aria-pressed="${sel}" aria-label="${esc(fmtDate(iso))}">${d}</button>`;
  }
  const prevOk=first>new Date(today.getFullYear(),today.getMonth(),1), nextOk=new Date(calY,calM+1,1)<=max;
  $('#calBox').innerHTML=`<div class="cal-h"><button type="button" class="cal-nav" data-nav="-1" ${prevOk?'':'disabled'} aria-label="Previous month">‹</button><b>${esc(title)}</b><button type="button" class="cal-nav" data-nav="1" ${nextOk?'':'disabled'} aria-label="Next month">›</button></div><div class="cal-g">${cells}</div>`;
  const picked=[...calSel].sort();
  $('#calPicked').innerHTML=picked.length?picked.map(d=>`<span class="chip-s">${esc(fmtDay(d))}</span>`).join(''):'<span style="color:var(--muted);font-size:14.5px">No dates picked yet</span>';
}
function buildTimeChips(){
  const sel=$('#f_cafe'), c=DB.get('cafes',[]).find(x=>x.id===(sel&&sel.value));
  const slots=TIMES.filter(t=>!c||cafeOpenAt(c,t));
  const sig=(c?c.id+(c.open||'')+(c.close||'')+(c.hours||''):'')+'|'+slots.join(',');
  if(sig===slotSig) return; slotSig=sig;
  const keep=new Set(checked('time'));
  $('#timeChips').innerHTML=slots.length?slots.map(t=>chip('time',t,esc(fmtRange(t)),'',keep.has(t))).join(''):'<span style="color:var(--muted)">This café has no open one-hour slots between 8 AM and 10 PM.</span>';
  $('#timeNote').textContent=(c&&cafeHours(c))?'Showing the slots when '+c.name+' is open ('+(c.hours||hoursLabel(c.open,c.close))+').':'Slots run from 8 AM to 10 PM. Pick a café above to see only its opening hours.';
}
function buildForm(){
  $('#f_place').innerHTML = '<option value="">Select your area</option>'+AREAS.map(a=>`<option>${a}</option>`).join('');
  $('#f_cat').innerHTML = '<option value="">Select your occupation</option>'+CATS.map(c=>`<option value="${c.id}">${c.icon} ${c.label}${c.sub?' ('+c.sub+')':''}</option>`).join('');
  $('#fieldChips').innerHTML = FIELDS.map(f=>chip('field',f,esc(f))).join('');
  $('#likeChips').innerHTML = LIKES.map(f=>chip('like',f,esc(f))).join('');
  $('#genderChips').innerHTML = ['Male','Female','Anyone'].map((g,i)=>chip('lookGender',g,g==='Anyone'?'Anyone':'A '+g.toLowerCase(),'',i===2)).join('');
  $('#wantChips').innerHTML = CATS.map(c=>chip('want',c.id,c.icon+' '+esc(c.label),c.sub)).join('');
  $('#c_area').innerHTML = AREAS.map(a=>`<option>${a}</option>`).join('');
  const hrOpts=(from,to,sel)=>{ let o=''; for(let h=from;h<=to;h++){ const v=p2(h)+':00'; o+=`<option value="${v}" ${v===sel?'selected':''}>${fmtTime(v)}</option>`; } return o; };
  $('#c_open').innerHTML=hrOpts(6,22,'08:00'); $('#c_close').innerHTML=hrOpts(8,24,'22:00');
  calInit();
  refreshCafeSelect(); buildTimeChips();
}
function refreshCafeSelect(selected){
  const cafes = DB.get('cafes',[]);
  const sel = $('#f_cafe');
  const param = selected || new URLSearchParams(location.search).get('cafe');
  let html = '<option value="">Any partner café</option>' + cafes.map(c=>`<option value="${esc(c.id)}">${esc(c.name)} · ${esc(c.area)}</option>`).join('');
  const pName = new URLSearchParams(location.search).get('n');
  if(param && !cafes.find(c=>c.id===param) && pName) html += `<option value="${esc(param)}">${esc(pName)}</option>`;
  sel.innerHTML = html;
  if(param) sel.value = param;
}
let wantAll=false;
$('#selAll').onclick=()=>{ wantAll=!wantAll; document.querySelectorAll('input[name=want]').forEach(i=>i.checked=wantAll); $('#selAll').textContent = wantAll?'Clear all groups':'Select all groups'; };

/* ============ QR SCAN CONTEXT ============ */
const params = new URLSearchParams(location.search);
const scanCafeId = params.get('cafe');
function scanCafeName(){
  const c = DB.get('cafes',[]).find(x=>x.id===scanCafeId);
  return c ? c.name : (params.get('n') || '');
}
if(scanCafeId){
  $('#scanBox').classList.add('on');
  $('#scanCafe').textContent = scanCafeName() || 'a partner café';
  setTimeout(()=>{ const r=$('#register'); if(r) r.scrollIntoView(); },300);
}

/* ============ REGISTER ============ */
function checked(name){ return [...document.querySelectorAll(`input[name=${name}]:checked`)].map(i=>i.value); }
$('#regForm').addEventListener('submit',async e=>{
  e.preventDefault();
  const err=$('#regErr'); err.textContent='';
  const phone=cleanPhone($('#f_phone').value), email=$('#f_email').value.trim();
  const u = {
    name:$('#f_name').value.trim(), age:parseInt($('#f_age').value,10),
    gender:$('#f_gender').value, area:$('#f_place').value,
    cat:$('#f_cat').value, role:$('#f_role').value.trim(), fields:checked('field'), likes:checked('like'),
    about:$('#f_about').value.trim(), lookGender:(checked('lookGender')[0]||'Anyone'), wants:checked('want'),
    cafe:$('#f_cafe').value, slot:''
  };
  if(!u.name) return err.textContent='Please enter your name.';
  if(!(u.age>=18)) return err.textContent='You must be 18 or above to register.';
  if(phone.length!==10) return err.textContent='Enter a valid 10-digit phone number.';
  if(!u.gender) return err.textContent='Please select your gender.';
  if(!u.area) return err.textContent='Please select your area.';
  if(!u.cat) return err.textContent='Please select your occupation group.';
  if(!u.wants.length) return err.textContent='Pick at least one group you would like to meet.';
  const dayVals=[...calSel].sort(), timeVals=checked('time').sort();
  if(!dayVals.length) return err.textContent='Pick at least one date on the calendar.';
  if(!timeVals.length) return err.textContent='Choose at least one time that suits you.';
  u.slot=JSON.stringify({d:dayVals,t:timeVals});
  if(!$('#f_ok').checked) return err.textContent='Please tick the confirmation box.';

  const btn=e.target.querySelector('button[type=submit]'); btn.disabled=true;
  try{
    const h=await phoneHash(phone);
    const exId=await DB.phoneLookup(h);
    const users=DB.get('users',[]);
    const found=exId?users.find(x=>x.id===exId):null;
    let me;
    if(found){ Object.assign(found,u); me=found; }
    else { u.id=exId||uid(); u.created=Date.now(); u.seen=[]; users.push(u); me=u; }
    await DB.set('users',users);
    await DB.contactSet({id:me.id,name:u.name,phone:phone,email:email,created:me.created||Date.now()});
    if(!exId) await DB.phoneSet(h,me.id);
    DB.set('me',me.id);
    toast('You are registered. Finding your matches…');
    if(email) sendEmail(email,firstName(me.name),'You are registered with Coffee With Stranger',regMail(me));
    updateBell();
    setTimeout(()=>openMatches(),700);
  }catch(ex){ console.error(ex); err.textContent='We could not save your registration. Please check your internet and try again.'; }
  finally{ btn.disabled=false; }
});

/* ============ MATCHING ============ */
function genderOK(pref,g){ return pref==='Anyone' || pref===g; }
const LEVELS={3:'Perfect match',2:'Good match',1:'Also available'};
function matchesFor(me){
  const users = DB.get('users',[]), mw = me.wants||[];
  return users.filter(u=>u.id!==me.id && genderOK(me.lookGender||'Anyone',u.gender) && genderOK(u.lookGender||'Anyone',me.gender))
    .map(u=>{
      const sameArea = me.area===u.area || me.area==='Other' || u.area==='Other';
      const iWant = mw.includes(u.cat), theyWant = (u.wants||[]).includes(me.cat);
      const level = (iWant&&theyWant&&sameArea) ? 3 : (((iWant||theyWant)&&sameArea)||(iWant&&theyWant)) ? 2 : 1;
      const shared = [...new Set([...(u.fields||[]).filter(f=>(me.fields||[]).includes(f)),...(u.likes||[]).filter(l=>(me.likes||[]).includes(l))])];
      return {u,shared,mutual:theyWant,level,sameArea,score:level*100+shared.length*2+(commonTimes(me,u).length?3:0)};
    }).sort((a,b)=>b.score-a.score);
}
const pairId=(a,b)=>[a,b].sort().join('_');
function newCount(me){ return me ? matchesFor(me).filter(m=>!(me.seen||[]).includes(m.u.id)).length : 0; }
function getMe(){ const id=DB.get('me',null); return id ? DB.get('users',[]).find(u=>u.id===id) : null; }
let lastConf=null;
function checkConfirmed(){
  const me=getMe();
  if(!me){ lastConf=null; return; }
  const pairs=DB.get('pairs',{});
  const now=Object.keys(pairs).filter(pid=>{ const p=pairs[pid]; return p.ok&&p.ok[me.id]&&Object.keys(p.ok).filter(k=>p.ok[k]).length>=2; });
  if(lastConf!==null && now.some(pid=>!lastConf.includes(pid))){
    toast('🎉 It is a match! Open My matches to see the café, time and map.');
    try{ if('Notification' in window && Notification.permission==='granted') new Notification('Coffee With Stranger',{body:'Your meetup is confirmed. Open My matches for the café, time and map.'}); }catch(e){}
  }
  lastConf=now;
}
let lastNew=null;
function checkNewMatches(){
  const me=getMe();
  if(!me){ lastNew=null; return; }
  const n=newCount(me);
  if(lastNew!==null && n>lastNew){
    toast('🔔 Someone new is available to meet. Tap My matches to choose, or wait for your perfect match.');
    try{ if('Notification' in window && Notification.permission==='granted') new Notification('Coffee With Stranger',{body:'A new person matches your interests. Open My matches.'}); }catch(e){}
  }
  lastNew=n;
}
function updateBell(){
  const me=getMe(), n=newCount(me), d=$('#bellDot');
  d.textContent=n; d.classList.toggle('hidden',!n);
}
const TIMES=['08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00','18:00','19:00','20:00','21:00'];
const p2=n=>String(n).padStart(2,'0');
const isoDate=d=>d.getFullYear()+'-'+p2(d.getMonth()+1)+'-'+p2(d.getDate());
function avail(u){ try{ const o=JSON.parse(u.slot); if(o&&Array.isArray(o.d)&&Array.isArray(o.t)) return o; }catch(e){} return null; }
function fmtDay(d){ return new Date(d+'T12:00:00').toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short'}); }
function fmtDate(d){ return new Date(d+'T12:00:00').toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'}); }
function fmtTime(t){ const h=parseInt(t.slice(0,2),10)%24, m=t.slice(3,5); return ((h%12)||12)+':'+m+' '+(h<12?'AM':'PM'); }
function fmtRange(t){ const h=parseInt(t.slice(0,2),10); return fmtTime(t)+' – '+fmtTime(p2(h+1)+':'+t.slice(3,5)); }
const toMin=t=>parseInt(t.slice(0,2),10)*60+parseInt(t.slice(3,5)||'0',10);
const minToHM=m=>p2(Math.floor(m/60))+':'+p2(m%60);
function parseHours(txt){
  if(!txt) return null;
  const toks=[...String(txt).toLowerCase().matchAll(/(\d{1,2})(?::(\d{2}))?\s*(a\.?m\.?|p\.?m\.?)?/g)].map(m=>({h:parseInt(m[1],10),m:m[2]?parseInt(m[2],10):0,ap:m[3]?m[3][0]:''}));
  if(toks.length<2) return null;
  const a=toks[0], b=toks[1];
  if(a.h>24||b.h>24) return null;
  const h24=(x,ap)=>ap==='a'?(x.h===12?0:x.h):ap==='p'?(x.h===12?12:x.h+12):null;
  let o=h24(a,a.ap); if(o===null) o=a.h>=13?a.h:(a.h===12?12:(a.h>=5?a.h:a.h+12));
  let c=h24(b,b.ap);
  if(c===null){ if(b.h>=13) c=b.h; else { const am=b.h===12?12:b.h, pm=b.h===12?24:b.h+12; c=(pm>o&&pm-o<=18)?pm:am; if(c<=o) c=pm; } }
  if(c<=o) c+=12;
  if(c>24) return null;
  return {o:o*60+a.m,c:c*60+b.m};
}
function cafeHours(c){ if(!c) return null; if(c.open&&c.close) return {o:toMin(c.open),c:toMin(c.close)}; return parseHours(c.hours); }
function cafeOpenAt(c,t){ const h=cafeHours(c); if(!h) return true; const st=toMin(t); return st>=h.o && st+60<=h.c; }
function hoursLabel(o,c){ return fmtTime(o)+' – '+fmtTime(c); }
function hoursFields(txt){ const h=parseHours(txt); return h?{open:minToHM(h.o),close:minToHM(h.c)}:{}; }

function whenShort(w){ return fmtDay(w.d)+', '+fmtTime(w.t); }
function slotLabel(u){ const A=avail(u); return A ? A.d.map(fmtDay).join(', ')+' · '+A.t.map(fmtTime).join(', ') : (u.slot||''); }
function commonTimes(a,b){
  const A=avail(a), B=avail(b); if(!A||!B) return [];
  const out=[];
  A.d.filter(d=>B.d.includes(d)).sort().forEach(d=>A.t.filter(t=>B.t.includes(t)).sort().forEach(t=>{ if(new Date(d+'T'+t+':00').getTime()>Date.now()+3600000) out.push({d,t}); }));
  return out;
}
function meetWhen(a,b,cafe){ let c=commonTimes(a,b); if(cafe) c=c.filter(x=>cafeOpenAt(cafe,x.t)); return c.length?c[0]:null; }
function whenOf(p,a,b,cafe){ const s=p&&p.checkin&&p.checkin._when; if(s&&s.includes('T')){ const x=s.split('T'); return {d:x[0],t:x[1]}; } return meetWhen(a,b,cafe); }
function pickCafe(a,b){
  const cafes=DB.get('cafes',[]);
  return cafes.find(c=>c.id===a.cafe) || cafes.find(c=>c.id===b.cafe) || cafes.find(c=>c.area===a.area) || cafes.find(c=>c.area===b.area) || cafes[0] || null;
}

/* ============ MATCHES MODAL ============ */
function openMatches(){
  const me=getMe();
  if(!me){ openOv('signOv'); return; }
  const list=matchesFor(me), pairs=DB.get('pairs',{}), cafes=DB.get('cafes',[]);
  const seenBefore = me.seen||[];
  $('#mmTitle').textContent='Hi '+me.name.split(' ')[0]+', your matches';
  const perfect=list.filter(m=>m.level===3).length;
  $('#mmSub').textContent= list.length ? list.length+' '+(list.length>1?'people are':'person is')+' available to meet'+(perfect?' ('+perfect+' perfect match'+(perfect>1?'es':'')+')':'')+'. Tap OK on anyone you like, or wait for your perfect match.' : '';
  let html='';
  if(!list.length){
    html=`<div class="empty"><div class="ic">☕</div><h3>No matches yet</h3><p style="margin-top:6px">Nobody else is available yet. We'll show people here as soon as they register, and our team may also message you. Tip: choosing more groups to meet gives you more options.</p></div>`;
  } else {
    html=list.map(m=>{
      const u=m.u, p=pairs[pairId(me.id,u.id)]||{ok:{}};
      const iOk=!!p.ok[me.id], theyOk=!!p.ok[u.id], both=iOk&&theyOk;
      const isNew=!seenBefore.includes(u.id);
      const ct=commonTimes(me,u), whenLine=(avail(me)&&avail(u)) ? (ct.length ? '📅 Both free: <b>'+esc(whenShort(ct[0]))+'</b>'+(ct.length>1?' (+'+(ct.length-1)+' more options)':'') : '📅 No day and time in common yet') : '';
      let action='';
      if(both){
        const c=cafes.find(x=>x.id===p.cafe);
        const here = scanCafeId && p.cafe===scanCafeId;
        const checkedIn = p.checkin&&p.checkin[me.id];
        const w=whenOf(p,me,u,c);
        action=`<div class="confirmed">🎉 <b>You both said yes!</b>
          <div style="margin-top:8px"><b>${c?esc(c.name)+', '+esc(c.area):'A partner café (we will confirm it shortly)'}</b>${c&&c.address?'<br>'+esc(c.address):''}</div>
          <div style="margin-top:8px;font-size:17px">${w?'📅 <b>'+esc(fmtDate(w.d))+'</b><br>🕒 <b>'+esc(fmtRange(w.t))+'</b>':'📅 <b>Date and time to be confirmed.</b> You have no day and time in common, so we will message you to fix one.'}${c&&c.hours?'<br><span style="font-size:14.5px">Café timings: '+esc(c.hours)+'</span>':''}</div>
          ${c?`<div class="row" style="margin-top:10px"><a class="btn btn-ghost btn-sm" target="_blank" rel="noopener" href="${esc(mapUrl(c))}">📍 Open map</a><a class="btn btn-ghost btn-sm" target="_blank" rel="noopener" href="${esc(dirUrl(c))}">Directions</a></div>`:''}
          <div style="margin-top:8px;font-size:14.5px">We will also send these details on WhatsApp or email. Please arrive on time and scan the café's QR code to check in.</div>
          <div class="row" style="margin-top:12px">${checkedIn?'<span class="btn btn-yellow btn-sm">✅ Checked in</span>':`<button class="btn btn-yellow btn-sm" data-checkin="${esc(u.id)}">${here?'Check in now':'I have arrived'}</button>`}</div></div>`;
      } else if(iOk){
        action=`<div class="waiting">✔ You said OK. Waiting for ${esc(u.name.split(' ')[0])} to respond.</div>`;
      } else {
        action=`<div class="row"><button class="btn btn-primary btn-sm" data-ok="${esc(u.id)}">OK, let's meet</button><button class="btn btn-ghost btn-sm" data-skip="${esc(u.id)}">Not now</button></div>`;
      }
      return `<div class="match ${isNew?'new':''}">
        <div class="top"><div class="avatar">${esc(u.name.charAt(0).toUpperCase())}</div>
          <div><h3>${esc(u.name.split(' ')[0])}, ${esc(u.age)}<span class="tag-mutual">${LEVELS[m.level]}</span></h3>
          <small>${esc(catLabel(u.cat))}${u.role?' · '+esc(u.role):''} · ${esc(u.area)}</small></div></div>
        ${m.shared.length?`<div class="chips-static">${m.shared.map(s=>`<span class="chip-s">${esc(s)}</span>`).join('')}</div>`:''}
        ${u.about?`<p style="color:var(--muted);font-size:15px">${esc(u.about)}</p>`:''}
        ${whenLine?`<div style="font-size:15px;margin:6px 0">${whenLine}</div>`:''}
        ${action}</div>`;
    }).join('');
  }
  $('#mmBody').innerHTML=html;
  // mark as seen
  const users=DB.get('users',[]), mm=users.find(x=>x.id===me.id);
  if(mm){ mm.seen=list.map(m=>m.u.id).sort(); DB.set('users',users); } updateBell();
  openOv('matchOv');
}
$('#mmBody').addEventListener('click',e=>{
  const me=getMe(); if(!me) return;
  const ok=e.target.closest('[data-ok]'), skip=e.target.closest('[data-skip]'), ci=e.target.closest('[data-checkin]');
  const pairs=DB.get('pairs',{});
  if(ok){
    const other=DB.get('users',[]).find(x=>x.id===ok.dataset.ok);
    const id=pairId(me.id,other.id);
    const p=pairs[id]||(pairs[id]={ok:{},cafe:null,checkin:{}});
    p.ok[me.id]=true; DB.set('pairs',pairs);
    if(other.demo){ // sample members answer automatically
      setTimeout(()=>{ const pp=DB.get('pairs',{}); pp[id].ok[other.id]=true; const c=pickCafe(me,other); pp[id].cafe=c?c.id:null; DB.set('pairs',pp); openMatches(); toast('🎉 '+other.name.split(' ')[0]+' said yes too!'); },900);
    } else if(p.ok[other.id]){ const c=pickCafe(me,other); p.cafe=c?c.id:null; const wn=meetWhen(me,other,c); p.checkin=p.checkin||{}; p.checkin._when=wn?wn.d+'T'+wn.t:''; DB.set('pairs',pairs); toast('🎉 It is a match!'); }
    else toast('Sent. We will tell you when they respond.');
    openMatches();
  }
  if(skip){
    const users=DB.get('users',[]), m=users.find(x=>x.id===me.id);
    m.hidden=(m.hidden||[]); m.hidden.push(skip.dataset.skip); DB.set('users',users);
    toast('Skipped.'); openMatches();
  }
  if(ci){
    const id=pairId(me.id,ci.dataset.checkin), p=pairs[id];
    p.checkin=p.checkin||{}; p.checkin[me.id]=true; DB.set('pairs',pairs);
    toast('✅ Checked in. Enjoy your coffee!'); openMatches();
  }
});
// hide skipped people
const _mf=matchesFor;
matchesFor=function(me){ const h=me.hidden||[]; return _mf(me).filter(m=>!h.includes(m.u.id)); };
$('#alertBtn').onclick=async()=>{
  if(!('Notification' in window)){ toast('This browser does not support alerts.'); return; }
  const r=await Notification.requestPermission();
  toast(r==='granted'?'Alerts are on. You will be told when the site is open.':'Alerts are blocked in your browser settings.');
  $('#alertBtn').classList.toggle('hidden',r==='granted');
};
$('#bellBtn').onclick=()=>{ getMe()?openMatches():openOv('signOv'); };
$('#signinBtn').onclick=()=>openOv('signOv');
$('#signGo').onclick=async()=>{
  const p=cleanPhone($('#s_phone').value);
  if(p.length!==10){ $('#signErr').textContent='Enter a valid 10-digit phone number.'; return; }
  const id=await DB.phoneLookup(await phoneHash(p));
  const u=id && DB.get('users',[]).find(x=>x.id===id);
  if(!u){ $('#signErr').textContent='No profile found for this number. Please register first.'; return; }
  $('#signErr').textContent=''; DB.set('me',u.id); closeOv('signOv'); updateBell(); openMatches();
};

/* ============ PUBLIC CAFÉ LIST ============ */
function renderCafes(){
  const cafes=DB.get('cafes',[]);
  let html=cafes.map(c=>`<div class="cafe"><span class="badge">Live</span><h3>${esc(c.name)}</h3><p>${esc(c.area)}${c.address?' · '+esc(c.address):''}</p>${c.hours?`<p>Open ${esc(c.hours)}</p>`:''}<a class="btn btn-primary btn-sm" href="?cafe=${encodeURIComponent(c.id)}&n=${encodeURIComponent(c.name)}#register">Register here</a></div>`).join('');
  const live=new Set(cafes.map(c=>c.area));
  ['Indiranagar','Koramangala','Whitefield'].filter(a=>!live.has(a)).forEach(a=>{
    html+=`<div class="cafe"><span class="badge soon">Coming soon</span><h3>${a}</h3><p>We are looking for a café partner in ${a}.</p><a class="btn btn-ghost btn-sm" href="#owners">Partner with us</a></div>`;
  });
  $('#cafeGrid').innerHTML=html;
}

/* ============ CAFÉ OWNER REQUEST ============ */
$('#ownerForm').addEventListener('submit',async e=>{
  e.preventDefault();
  const r={id:uid(),name:$('#o_name').value.trim(),owner:$('#o_owner').value.trim(),phone:$('#o_phone').value.trim(),email:$('#o_email').value.trim(),addr:$('#o_addr').value.trim(),hours:$('#o_hours').value.trim(),created:Date.now()};
  if(!r.name||!r.owner||!r.phone||!r.addr){ $('#ownerErr').textContent='Please fill in all required fields.'; return; }
  $('#ownerErr').textContent='';
  const btn=e.target.querySelector('button[type=submit]'); btn.disabled=true;
  const msg='Hello, I would like to list my café on Coffee With Stranger.\nCafé: '+r.name+'\nName: '+r.owner+'\nPhone: '+r.phone+'\nArea: '+r.addr+(r.hours?'\nHours: '+r.hours:'');
  $('#ownerWa').href='https://wa.me/'+CFG.whatsapp+'?text='+encodeURIComponent(msg);
  try{
    if(FB_ON){ await fs.collection('requests').doc(r.id).set(r); }
    else { const reqs=lget('requests',[]); reqs.push(r); lset('requests',reqs); }
    notifyOwner('New café request: '+r.name,{cafe:r.name,owner:r.owner,phone:r.phone,email:r.email,address:r.addr,hours:r.hours});
    e.target.reset(); $('#ownerDone').classList.remove('hidden'); toast('Request received. We will call you within 48 hours.');
  }catch(ex){
    console.error(ex);
    $('#ownerErr').textContent='We could not send the request online. Please tap the WhatsApp button below to send it to us directly.';
    $('#ownerDone').classList.remove('hidden');
  }
  finally{ btn.disabled=false; }
});

/* ============ ADMIN (hidden) ============
   Open with  yoursite.com/#admin  or click the © line in the footer 5 times. */
let adminOn = false;
function openAdmin(){ openOv('adminOv'); showAdmin(); }
function showAdmin(){
  $('#adminLogin').classList.toggle('hidden',adminOn);
  $('#adminApp').classList.toggle('hidden',!adminOn);
  $('#a_emailField').classList.toggle('hidden',!FB_ON);
  $('#adminNote').textContent = FB_ON
    ? 'Connected: members, cafés and requests are shared across all devices. QR codes link to '+siteUrl()+'. Open this admin page from your live website so the QR links are correct.'
    : 'Demo mode: data is saved in this browser only. Connect Firebase (see SETUP.md) so cafés and requests are shared across all devices.';
  if(adminOn) renderAdmin();
}
$('#adminGo').onclick=async()=>{
  const err=$('#adminErr'); err.textContent='';
  if(!FB_ON){
    if($('#a_pass').value===CFG.demoPassword){ adminOn=true; $('#a_pass').value=''; showAdmin(); } else err.textContent='Wrong password.';
    return;
  }
  try{
    const cred=await auth.signInWithEmailAndPassword($('#a_email').value.trim(),$('#a_pass').value);
    if(cred.user.uid!==CFG.adminUid){ await auth.signOut(); err.textContent='This account is not the admin account.'; return; }
    $('#a_pass').value='';
  }catch(ex){ err.textContent='Sign-in failed. Check the email and password.'; }
};
$('#a_pass').addEventListener('keydown',e=>{ if(e.key==='Enter') $('#adminGo').click(); });
$('#adminOut').onclick=()=>{ adminOn=false; if(FB_ON&&auth) auth.signOut(); closeOv('adminOv'); showAdmin(); };
let clicks=0,ct; $('#copy').onclick=()=>{ clicks++; clearTimeout(ct); ct=setTimeout(()=>clicks=0,1500); if(clicks>=5){ clicks=0; openAdmin(); } };
$('#brand').addEventListener('click',()=>{});
window.addEventListener('hashchange',()=>{ if(location.hash==='#admin') openAdmin(); });
if(location.hash==='#admin') setTimeout(openAdmin,200);

function siteUrl(){ return location.origin+location.pathname; }
function cafeLink(c){ return siteUrl()+'?cafe='+encodeURIComponent(c.id)+'&n='+encodeURIComponent(c.name)+'#register'; }

function renderAdmin(){
  if(!adminOn) return;
  const users=DB.get('users',[]), cafes=DB.get('cafes',[]), pairs=Object.values(DB.get('pairs',{}));
  $('#stats').innerHTML=[
    [users.length,'Members'],[cafes.length,'Partner cafés'],
    [pairs.filter(p=>Object.keys(p.ok).length>1).length,'Confirmed meetups'],
    [pairs.reduce((n,p)=>n+Object.keys(p.checkin||{}).filter(k=>k!=='_when').length,0),'Check-ins']
  ].map(s=>`<div class="stat"><b>${s[0]}</b><span>${s[1]}</span></div>`).join('');

  const box=$('#adminCafes');
  box.innerHTML = cafes.length ? cafes.map(c=>`<div class="acafe" data-id="${esc(c.id)}"><div class="qr" id="qr_${esc(c.id)}"></div>
    <div class="info"><b>${esc(c.name)}</b><br>${esc(c.area)}${c.address?' · '+esc(c.address):''}<br>${c.owner?esc(c.owner)+' · ':''}${esc(c.phone||'')}${c.hours?'<br>Open '+esc(c.hours):''}</div>
    <div class="acts"><button class="btn btn-primary btn-sm" data-poster="${esc(c.id)}">Poster</button><button class="btn btn-ghost btn-sm" data-dl="${esc(c.id)}">Download QR</button><button class="btn btn-danger btn-sm" data-del="${esc(c.id)}">Remove</button></div></div>`).join('')
    : '<p style="color:var(--muted)">No cafés yet. Add your first partner on the left.</p>';
  cafes.forEach(c=>{
    const el=document.getElementById('qr_'+c.id);
    if(el && window.QRCode){ new QRCode(el,{text:cafeLink(c),width:96,height:96,correctLevel:QRCode.CorrectLevel.M}); }
    else if(el){ el.textContent='QR unavailable'; }
  });

  const reqs=DB.get('requests',[]);
  $('#reqHead').textContent='Café requests from owners'+(reqs.length?' ('+reqs.length+' pending)':'');
  $('#reqList').innerHTML = reqs.length ? reqs.map(r=>`<div class="req"><b>${esc(r.name)}</b> · ${esc(r.addr)}<br>${esc(r.owner)} · ${esc(r.phone)}${r.hours?' · '+esc(r.hours):''}
    <div style="display:flex;gap:8px;margin-top:8px"><button class="btn btn-primary btn-sm" data-approve="${esc(r.id)}">Approve and add</button><button class="btn btn-danger btn-sm" data-reject="${esc(r.id)}">Reject</button></div></div>`).join('')
    : '<p style="color:var(--muted);font-size:14.5px">No pending requests.</p>';
  renderMeetups();
  renderMembers();
  if($('#autoMail').checked) sendPendingEmails(false);
}
$('#cafeForm').addEventListener('submit',e=>{
  e.preventDefault(); if(!adminOn) return;
  const c={id:uid(),name:$('#c_name').value.trim(),area:$('#c_area').value,phone:$('#c_phone').value.trim(),address:$('#c_addr').value.trim(),owner:$('#c_owner').value.trim(),open:$('#c_open').value,close:$('#c_close').value,hours:hoursLabel($('#c_open').value,$('#c_close').value),map:(/^https?:\/\//.test($('#c_map').value.trim())?$('#c_map').value.trim():'')};
  if(!c.name){ $('#cafeErr').textContent='Enter the café name.'; return; }
  if(c.close<=c.open){ $('#cafeErr').textContent='Closing time must be after opening time.'; return; }
  $('#cafeErr').textContent='';
  const cafes=DB.get('cafes',[]); cafes.push(c); DB.set('cafes',cafes);
  e.target.reset(); renderAdmin(); renderCafes(); refreshCafeSelect(); toast('Café added. Its poster is ready.'); openPoster(c);
});
$('#adminApp').addEventListener('click',e=>{
  if(!adminOn) return;
  const pb=e.target.closest('[data-poster]');
  if(pb){ const pc=DB.get('cafes',[]).find(x=>x.id===pb.dataset.poster); if(pc) openPoster(pc); return; }
  const del=e.target.closest('[data-del]'), dl=e.target.closest('[data-dl]'), ap=e.target.closest('[data-approve]'), rj=e.target.closest('[data-reject]');
  if(del && confirm('Remove this café?')){ DB.set('cafes',DB.get('cafes',[]).filter(c=>c.id!==del.dataset.del)); renderAdmin(); renderCafes(); refreshCafeSelect(); }
  if(dl){
    const c=DB.get('cafes',[]).find(x=>x.id===dl.dataset.dl), cv=document.querySelector('#qr_'+c.id+' canvas');
    if(cv){ const big=document.createElement('div'); new QRCode(big,{text:cafeLink(c),width:600,height:600,correctLevel:QRCode.CorrectLevel.M});
      setTimeout(()=>{ const bc=big.querySelector('canvas'); const a=document.createElement('a'); a.download='QR-'+c.name.replace(/\W+/g,'-')+'.png'; a.href=bc.toDataURL('image/png'); a.click(); },200); }
  }
  if(ap){
    const reqs=DB.get('requests',[]), r=reqs.find(x=>x.id===ap.dataset.approve);
    const cafes=DB.get('cafes',[]); const newCafe={id:uid(),name:r.name,area:(AREAS.find(a=>a!=='Other'&&(r.addr||'').toLowerCase().includes(a.toLowerCase()))||'Other'),phone:r.phone,address:r.addr,owner:r.owner,hours:r.hours}; Object.assign(newCafe,hoursFields(r.hours)); cafes.push(newCafe);
    DB.set('cafes',cafes); DB.set('requests',reqs.filter(x=>x.id!==r.id)); renderAdmin(); renderCafes(); refreshCafeSelect(); toast('Café approved. Its poster is ready.'); openPoster(newCafe);
  }
  if(rj){ DB.set('requests',DB.get('requests',[]).filter(x=>x.id!==rj.dataset.reject)); renderAdmin(); }
});
/* ============ CAFÉ POSTER (made automatically for every café) ============ */
const POSTER_WHO=['IT professionals','Doctors','Lawyers','Founders','Creatives','Students','Business owners','Real estate','Teachers','Engineers','Designers'];
function freeUntilText(){
  const end=new Date(CFG.launchDate+'T00:00:00').getTime()+CFG.freeDays*864e5;
  if(end<=Date.now()) return '';
  return new Date(end-864e5).toLocaleDateString('en-IN',{day:'numeric',month:'short'});
}
function posterHTML(c){
  const IMG=(document.querySelector('.couple img')||{}).src||'';
  const nm=String(c.name||''), FS=nm.length<=14?34:(nm.length<=24?29:25);
  const NAME=esc(nm), EMAIL=esc(CFG.posterEmail||'');
  const LOC=esc([c.area,c.address].filter(Boolean).join(', '));
  const until=freeUntilText();
  const STICKER=until?`<div style="position: absolute; right: 14px; top: 196px; z-index: 5; width: 150px; height: 150px; border-radius: 75px; background: #2A1810; color: #F4A340; transform: rotate(-10deg); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; box-shadow: 0 6px 14px rgba(42, 24, 16, 0.35)"><div style="position: absolute; left: 6px; top: 6px; right: 6px; bottom: 6px; border: 2px dashed #F4A340; border-radius: 69px"></div><div style="font-family: 'Bricolage Grotesque', 'DM Sans', system-ui, sans-serif; font-size: 42px; line-height: 1; font-weight: 800">FREE</div><div style="font-size: 16px; font-weight: 700; color: #FFF4E0; margin-top: 3px; line-height: 1.15">registration<br>till ${esc(until)}</div></div>`:'';
  return `<div id="posterSheet" style="position: relative; width: 794px; height: 1123px; box-sizing: border-box; display: flex; flex-direction: column; background: #F4A340; color: #2A1810; font-family: 'Hanken Grotesk', 'DM Sans', system-ui, sans-serif; overflow: hidden">

<div style="position: relative; padding: 28px 48px 0 48px">

<svg width="196" height="192" viewBox="-10 -10 260 256" aria-hidden="true" style="position: absolute; right: 22px; top: 6px; z-index: 1; overflow: visible">
<defs>
<linearGradient id="cupG" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#9A6340"></stop><stop offset="0.5" stop-color="#5A3A28"></stop><stop offset="1" stop-color="#2A1810"></stop></linearGradient>
<linearGradient id="saucerG" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#6B4430"></stop><stop offset="1" stop-color="#2A1810"></stop></linearGradient>
<radialGradient id="coffeeG" cx="0.5" cy="0.45" r="0.6"><stop offset="0" stop-color="#8A5530"></stop><stop offset="1" stop-color="#2F1A10"></stop></radialGradient>
<filter id="fogBlur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6"></feGaussianBlur></filter>
<filter id="wispBlur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.2"></feGaussianBlur></filter>
</defs>
<ellipse cx="120" cy="216" rx="100" ry="9" fill="#2A1810" opacity="0.3" filter="url(#wispBlur)"></ellipse>
<path d="M190 132C232 122 232 184 184 180" fill="none" stroke="#2A1810" stroke-width="16" stroke-linecap="round"></path>
<path d="M190 132C232 122 232 184 184 180" fill="none" stroke="#5A3A28" stroke-width="6" stroke-linecap="round"></path>
<ellipse cx="120" cy="204" rx="98" ry="16" fill="url(#saucerG)"></ellipse>
<ellipse cx="120" cy="202" rx="72" ry="9" fill="#2A1810" opacity="0.55"></ellipse>
<path d="M46 120C46 176 78 206 120 206C162 206 194 176 194 120Z" fill="url(#cupG)"></path>
<path d="M62 134C62 160 76 184 96 196" fill="none" stroke="#FFFFFF" stroke-width="7" stroke-linecap="round" opacity="0.35"></path>
<ellipse cx="120" cy="120" rx="74" ry="18" fill="#C99A6B"></ellipse>
<ellipse cx="120" cy="121" rx="64" ry="14.5" fill="url(#coffeeG)"></ellipse>
<path d="M80 112c-14-10-21-18-21-26a10.5 10.5 0 0 1 21-3 10.5 10.5 0 0 1 21 3c0 8-7 16-21 26z" transform="translate(120 121) scale(0.27) translate(-80 -92)" fill="#FFF4E0" opacity="0.9"></path>
<g filter="url(#fogBlur)" fill="#FFF4E0">
<ellipse cx="120" cy="92" rx="30" ry="16" opacity="0.55"></ellipse>
<ellipse cx="126" cy="66" rx="24" ry="14" opacity="0.45"></ellipse>
<ellipse cx="118" cy="42" rx="20" ry="12" opacity="0.35"></ellipse>
</g>
<g fill="none" stroke="#FFFFFF" stroke-linecap="round" filter="url(#wispBlur)">
<path d="M104 110C88 88 128 76 108 52C96 38 118 26 110 8" stroke-width="6" opacity="0.8"></path>
<path d="M134 110C118 90 152 78 136 56" stroke-width="5" opacity="0.65"></path>
</g>
<path transform="translate(58 66) scale(1.5)" d="M0 7C-11 -2 -13 -11 -6.5 -13C-3 -14 0 -11 0 -8C0 -11 3 -14 6.5 -13C13 -11 11 -2 0 7Z" fill="#FFF4E0"></path>
<g transform="translate(172 40) scale(1.5)" fill="#FFF4E0"><ellipse cx="0" cy="0" rx="6" ry="4.4" transform="rotate(-20)"></ellipse><ellipse cx="13" cy="-3" rx="6" ry="4.4" transform="rotate(-20 13 -3)"></ellipse><rect x="4.6" y="-24" width="2.4" height="24"></rect><rect x="17.6" y="-27" width="2.4" height="24"></rect><path d="M4.6 -24L20 -28L20 -23L4.6 -19Z"></path></g>
<path transform="translate(118 2) scale(1.05)" d="M0 7C-11 -2 -13 -11 -6.5 -13C-3 -14 0 -11 0 -8C0 -11 3 -14 6.5 -13C13 -11 11 -2 0 7Z" fill="#FFF4E0"></path>
<g transform="translate(40 22) scale(1.3)" fill="#FFF4E0"><ellipse cx="0" cy="0" rx="6" ry="4.4" transform="rotate(-20)"></ellipse><rect x="4.6" y="-24" width="2.4" height="24"></rect><path d="M7 -24C13 -21 15 -15 12 -9" fill="none" stroke="#FFF4E0" stroke-width="2.6" stroke-linecap="round"></path></g>
<path transform="translate(194 84) scale(0.95)" d="M0 7C-11 -2 -13 -11 -6.5 -13C-3 -14 0 -11 0 -8C0 -11 3 -14 6.5 -13C13 -11 11 -2 0 7Z" fill="#FFF4E0"></path>
</svg>

${STICKER}

<div style="position: relative; z-index: 2; font-family: Pacifico, 'Brush Script MT', cursive; font-size: 112px; line-height: 1.1; color: #2A1810">Coffee</div>

<div style="position: relative; z-index: 2; display: block; width: max-content; margin: 10px 0 0 6px; transform: rotate(-2deg); background: #2A1810; color: #F4A340; font-family: 'Bricolage Grotesque', 'DM Sans', system-ui, sans-serif; font-size: 44px; line-height: 1; font-weight: 800; letter-spacing: 0.1em; padding: 10px 24px 12px 28px; border-radius: 20px">WITH STRANGER</div>

<div style="position: relative; z-index: 3; margin: 20px 0 -40px 0; height: 388px; border-radius: 28px; overflow: hidden; background: #FCFDF8; box-shadow: 0 16px 34px rgba(42, 24, 16, 0.38); border: 5px solid #FFF4E0; box-sizing: border-box">
<img src="${IMG}" alt="A man and a woman smiling and talking over cups of coffee at a café table" style="display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%">
</div>

</div>

<div style="flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; background: #2A1810; color: #FFF4E0; border-radius: 36px 36px 0 0; padding: 56px 48px 14px 48px">

<div style="display: flex; gap: 28px; align-items: flex-start">
<div style="flex-grow: 1; min-width: 0; display: flex; flex-direction: column">
<div style="font-family: 'Bricolage Grotesque', 'DM Sans', system-ui, sans-serif; font-size: ${FS}px; line-height: 1.08; font-weight: 800; letter-spacing: -0.015em">Meet someone new at <span style="color: #F4A340">${NAME}</span></div>
<p style="margin: 8px 0 0 0; font-size: 20px; line-height: 1.3; font-weight: 500; color: #F3E3CC">Spark great conversations over coffee.</p>
<div style="margin-top: 6px; font-size: 17px; color: #F3E3CC">📍 ${LOC}</div>
<div style="display: flex; flex-direction: column; gap: 10px; margin-top: 16px">
<div style="display: flex; align-items: center; gap: 12px"><div style="flex-shrink: 0; width: 34px; height: 34px; border-radius: 17px; background: #F4A340; color: #2A1810; font-size: 19px; font-weight: 800; display: flex; align-items: center; justify-content: center">1</div><div style="font-size: 20px; line-height: 1.2">Scan and fill in your interests</div></div>
<div style="display: flex; align-items: center; gap: 12px"><div style="flex-shrink: 0; width: 34px; height: 34px; border-radius: 17px; background: #F4A340; color: #2A1810; font-size: 19px; font-weight: 800; display: flex; align-items: center; justify-content: center">2</div><div style="font-size: 20px; line-height: 1.2">Get matched with someone who shares your interests</div></div>
<div style="display: flex; align-items: center; gap: 12px"><div style="flex-shrink: 0; width: 34px; height: 34px; border-radius: 17px; background: #F4A340; color: #2A1810; font-size: 19px; font-weight: 800; display: flex; align-items: center; justify-content: center">3</div><div style="font-size: 20px; line-height: 1.2">Tap OK and meet at a partner café</div></div>
</div>
</div>
<div style="flex-shrink: 0; width: 288px; height: 288px; background: #FFFFFF; border-radius: 22px; padding: 12px; box-sizing: border-box">
<div id="posterQR" style="width: 264px; height: 264px"></div>
</div>
</div>

<div style="display: flex; flex-direction: column; gap: 8px">
<div style="font-size: 16px; font-weight: 700; letter-spacing: 0.14em; color: #F4A340">WHO WILL YOU MEET?</div>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">IT professionals</div>
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">Doctors</div>
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">Lawyers</div>
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">Founders</div>
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">Creatives</div>
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">Students</div>
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">Business owners</div>
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">Real estate</div>
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">Teachers</div>
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">Engineers</div>
<div style="border: 1.5px solid #B9A58E; border-radius: 999px; padding: 6px 14px; font-size: 16px; font-weight: 500">Designers</div>
</div>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; border-top: 1px solid #6B5645; padding-top: 12px; font-size: 16px; color: #F3E3CC">
<div>Questions? ${EMAIL}</div>
<div>Point your camera at the code</div>
</div>

</div>
</div>`;
}
function fitPoster(){
  const f=$('#posterFrame'); if(!f||!f.parentElement) return;
  const w=Math.min(420,Math.max(240,f.parentElement.clientWidth-8)), sc=w/794;
  f.style.width=(794*sc)+'px'; f.style.height=(1123*sc)+'px';
  $('#posterPrint').style.transform='scale('+sc+')';
}
function openPoster(c){
  $('#posterTitle').textContent='Poster for '+c.name;
  $('#posterPrint').innerHTML=posterHTML(c);
  const q=$('#posterQR');
  if(q && window.QRCode){ new QRCode(q,{text:cafeLink(c),width:264,height:264,correctLevel:QRCode.CorrectLevel.M}); }
  openOv('posterOv'); fitPoster();
}
$('#posterPrintBtn').onclick=async()=>{
  try{ if(document.fonts&&document.fonts.ready) await document.fonts.ready; }catch(e){}
  $('#posterPrint').style.transform='none';
  document.body.classList.add('printing-poster');
  setTimeout(()=>window.print(),200);
};
window.addEventListener('afterprint',()=>{ document.body.classList.remove('printing-poster'); if($('#posterOv').classList.contains('on')) fitPoster(); });
window.addEventListener('resize',()=>{ if($('#posterOv').classList.contains('on')) fitPoster(); });

const firstName=n=>String(n||'').split(' ')[0];
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const EMAILJS_ON=()=>!!(CFG.emailjs&&CFG.emailjs.publicKey&&CFG.emailjs.serviceId&&CFG.emailjs.templateId);
function notifMap(){ const m={}; if(FB_ON) cache.notifs.forEach(n=>m[n.id]=n); else Object.assign(m,lget('notifs',{})); return m; }
async function saveNotif(rec){
  if(FB_ON){
    const i=cache.notifs.findIndex(n=>n.id===rec.id); if(i>=0) cache.notifs[i]=rec; else cache.notifs.push(rec);
    await fs.collection('notifs').doc(rec.id).set(rec).catch(e=>console.error(e));
  } else { const m=lget('notifs',{}); m[rec.id]=rec; lset('notifs',m); }
}
async function markNotified(u,list){
  const o=notifMap()[u.id]||{};
  await saveNotif({id:u.id,ids:[...new Set((o.ids||[]).concat(list.map(m=>m.u.id)))],meet:o.meet||[],via:o.via||{},at:Date.now()});
}
async function markMeet(u,pid,via){
  const o=notifMap()[u.id]||{};
  await saveNotif({id:u.id,ids:o.ids||[],meet:[...new Set((o.meet||[]).concat([pid]))],via:Object.assign({},o.via||{},{[pid]:via}),at:Date.now()});
}
function pendingFor(u){ const told=(notifMap()[u.id]||{}).ids||[]; return matchesFor(u).filter(m=>!told.includes(m.u.id)); }
function msgText(u,list){
  if(!list.length) return null;
  const top=list.slice(0,5).map(m=>firstName(m.u.name)+' ('+catLabel(m.u.cat)+', '+m.u.area+(m.level===3?', perfect match':'')+')').join('; ');
  return 'Hi '+firstName(u.name)+', good news from Coffee With Stranger! '+list.length+(list.length>1?' people are':' person is')+' now available to meet: '+top+'. You can choose someone you like, or wait for your perfect match. Open '+siteUrl()+' and tap My matches. Sign in with the phone number you registered with.';
}
function memberMsg(u){
  const pend=pendingFor(u), t=msgText(u,pend.length?pend:matchesFor(u));
  return t||('Hi '+firstName(u.name)+', thank you for registering with Coffee With Stranger. We will message you as soon as someone is available to meet.');
}
function regMail(me){
  const n=matchesFor(me).length;
  return 'Hi '+firstName(me.name)+', you are registered with Coffee With Stranger. '+(n?n+(n>1?' people are':' person is')+' already available to meet. Open '+siteUrl()+' and tap My matches to choose someone, or wait for your perfect match.':'Nobody else is available yet, but we will let you know as soon as someone is. You can also open '+siteUrl()+' any time and tap My matches.');
}
const mapQuery=c=>[c.name,c.address||c.area,'Bengaluru'].join(', ');
const mapUrl=c=>c.map||('https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(mapQuery(c)));
const dirUrl=c=>'https://www.google.com/maps/dir/?api=1&destination='+encodeURIComponent(mapQuery(c));
function confirmedPairs(){
  const pairs=DB.get('pairs',{}), users=DB.get('users',[]), cafes=DB.get('cafes',[]), out=[];
  Object.keys(pairs).forEach(pid=>{
    const p=pairs[pid], ids=Object.keys(p.ok||{}).filter(k=>p.ok[k]);
    if(ids.length<2) return;
    const a=users.find(x=>x.id===ids[0]), b=users.find(x=>x.id===ids[1]); if(!a||!b) return;
    const cf=cafes.find(c=>c.id===p.cafe)||null; const w=whenOf(p,a,b,cf); out.push({pid,a,b,cafe:cf,when:w,slot:w?whenShort(w):'Day and time to be confirmed'});
  });
  return out;
}
function meetText(u,o,c,w){
  return 'Hi '+firstName(u.name)+', great news from Coffee With Stranger! You and '+firstName(o.name)+' ('+catLabel(o.cat)+') both said yes, so you can meet.\n'
    +(w?'Date: '+fmtDate(w.d)+'\nTime: '+fmtRange(w.t)+'\n':'Date and time: we will confirm with you shortly.\n')
    +'Café: '+(c?c.name+', '+(c.address||c.area):'a partner café (we will confirm it shortly)')+(c&&c.hours?'\nCafé timings: '+c.hours:'')+(c?'\nMap: '+mapUrl(c):'')+'\n'
    +(w?'If this date or time does not work for you, reply to this message and we will find another. ':'Please reply with the day and time you prefer and we will confirm it with '+firstName(o.name)+'. ')
    +'Meet only inside the café, and scan the café QR code when you arrive.';
}
async function sendEmail(to,name,subject,message){
  if(!EMAILJS_ON()) return false;
  const e=CFG.emailjs;
  try{
    const r=await fetch('https://api.emailjs.com/api/v1.0/email/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({service_id:e.serviceId,template_id:e.templateId,user_id:e.publicKey,template_params:{to_email:to,to_name:name,subject:subject,message:message}})});
    return !!(r&&r.ok);
  }catch(x){ return false; }
}
let mailBusy=false, mailFailAt=0;
async function sendPendingEmails(manual){
  if(mailBusy||!EMAILJS_ON()||!adminOn) return 0;
  if(!manual && Date.now()-mailFailAt<60000) return 0;
  mailBusy=true; let sent=0, failed=false;
  try{
    const cm=contactMap();
    for(const x of confirmedPairs()){
      for(const [u,o] of [[x.a,x.b],[x.b,x.a]]){
        const c=cm[u.id]; if(!c||!c.email) continue;
        if(((notifMap()[u.id]||{}).meet||[]).includes(x.pid)) continue;
        const ok=await sendEmail(c.email,firstName(u.name),'Your coffee meetup is confirmed ☕',meetText(u,o,x.cafe,x.when));
        if(ok){ await markMeet(u,x.pid,'email'); sent++; await sleep(1100); } else { failed=true; break; }
      }
      if(failed) break;
    }
    if(!failed) for(const u of DB.get('users',[])){
      const c=cm[u.id]; if(!c||!c.email) continue;
      const list=pendingFor(u); if(!list.length) continue;
      const ok=await sendEmail(c.email,firstName(u.name),'People are available to meet at Coffee With Stranger',msgText(u,list));
      if(ok){ await markNotified(u,list); sent++; await sleep(1100); } else { failed=true; break; }
    }
  } finally { mailBusy=false; }
  if(failed) mailFailAt=Date.now();
  if(manual) toast(failed?'Some emails could not be sent. Check the EmailJS settings.':(sent+' email'+(sent===1?'':'s')+' sent.'));
  if(sent){ renderMeetups(); renderMembers(); }
  return sent;
}
function renderMembers(){
  if(!adminOn) return;
  const users=DB.get('users',[]), cm=contactMap(), q=($('#memberSearch').value||'').toLowerCase().trim();
  $('#mailState').textContent = EMAILJS_ON() ? 'Email sending is on.' : 'Email sending is not set up yet (see SETUP.md). Email buttons will open your mail app.';
  let rows=users.map(u=>({u,c:cm[u.id]||{},ms:matchesFor(u),pend:pendingFor(u)}));
  if(q) rows=rows.filter(r=>[r.u.name,r.c.phone,r.c.email,r.u.area,catLabel(r.u.cat),r.u.role].join(' ').toLowerCase().includes(q));
  rows.sort((a,b)=>b.pend.length-a.pend.length||(b.u.created||0)-(a.u.created||0));
  const toTell=rows.filter(r=>r.pend.length).length;
  $('#memHead').textContent='Members ('+users.length+')'+(toTell?' · '+toTell+' to notify':'');
  $('#memberList').innerHTML = rows.length ? rows.slice(0,200).map(r=>{
    const u=r.u, c=r.c, perfect=r.ms.filter(m=>m.level===3).length;
    const msg=memberMsg(u);
    const wa=c.phone?'https://wa.me/91'+encodeURIComponent(c.phone)+'?text='+encodeURIComponent(msg):'';
    const mail=c.email?(EMAILJS_ON()?`<button class="btn btn-ghost btn-sm" data-email="${esc(u.id)}">Send email</button>`:`<a class="btn btn-ghost btn-sm" href="mailto:${encodeURIComponent(c.email)}?subject=${encodeURIComponent('People are available to meet at Coffee With Stranger')}&body=${encodeURIComponent(msg)}">Email</a>`):'';
    return `<div class="req"><b>${esc(u.name)}</b>, ${esc(u.age)} · ${esc(u.gender)} · ${esc(catLabel(u.cat))}${u.role?' ('+esc(u.role)+')':''} · ${esc(u.area)} · ${esc(slotLabel(u))}<br>
      📞 ${c.phone?esc(c.phone):'not loaded'}${c.email?' · ✉ '+esc(c.email):''}<br>
      <span style="color:var(--muted)">Wants to meet: ${esc((u.wants||[]).map(catLabel).join(', '))} (${esc(u.lookGender||'Anyone')})</span><br>
      <b>${r.ms.length}</b> available${perfect?', '+perfect+' perfect':''}${r.pend.length?' · <b>'+r.pend.length+' new, not told yet</b>':' · all told'}
      <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">${wa?`<a class="btn btn-primary btn-sm" target="_blank" rel="noopener" data-notify="${esc(u.id)}" href="${esc(wa)}">WhatsApp${r.pend.length?' ('+r.pend.length+' new)':''}</a>`:''}${c.phone?`<a class="btn btn-ghost btn-sm" href="tel:+91${esc(c.phone)}">Call</a>`:''}${mail}</div></div>`;
  }).join('') : '<p style="color:var(--muted);font-size:14.5px">No members yet.</p>';
}
function renderMeetups(){
  if(!adminOn) return;
  const list=confirmedPairs(), cm=contactMap(), nm=notifMap();
  $('#meetHead').textContent='Confirmed meetups ('+list.length+')';
  $('#meetList').innerHTML = list.length ? list.map(x=>{
    const row=(u,o)=>{
      const c=cm[u.id]||{}, n=nm[u.id]||{}, told=(n.meet||[]).includes(x.pid), via=(n.via||{})[x.pid];
      const msg=meetText(u,o,x.cafe,x.when);
      const wa=c.phone?`<a class="btn btn-primary btn-sm" target="_blank" rel="noopener" data-meetwa="${esc(x.pid)}|${esc(u.id)}" href="${esc('https://wa.me/91'+encodeURIComponent(c.phone)+'?text='+encodeURIComponent(msg))}">WhatsApp</a>`:'';
      const em=c.email?(EMAILJS_ON()?`<button class="btn btn-ghost btn-sm" data-meetmail="${esc(x.pid)}|${esc(u.id)}">Send email</button>`:`<a class="btn btn-ghost btn-sm" href="mailto:${encodeURIComponent(c.email)}?subject=${encodeURIComponent('Your coffee meetup is confirmed')}&body=${encodeURIComponent(msg)}">Email</a>`):'';
      return `<div style="margin-top:10px"><b>${esc(firstName(u.name))}</b> · 📞 ${esc(c.phone||'not loaded')}${c.email?' · ✉ '+esc(c.email):' · no email'} · ${told?'<b>told ✓ ('+esc(via||'')+')</b>':'<b>not told yet</b>'}<div style="display:flex;gap:8px;margin-top:6px;flex-wrap:wrap">${wa}${em}</div></div>`;
    };
    return `<div class="req"><b>${esc(x.a.name)} &amp; ${esc(x.b.name)}</b><br>${x.cafe?esc(x.cafe.name)+', '+esc(x.cafe.area):'No café assigned yet'} · ${esc(x.slot)}${row(x.a,x.b)}${row(x.b,x.a)}</div>`;
  }).join('') : '<p style="color:var(--muted);font-size:14.5px">No confirmed meetups yet.</p>';
}
$('#meetList').addEventListener('click',async e=>{
  const w=e.target.closest('[data-meetwa]'), m=e.target.closest('[data-meetmail]');
  const t=w||m; if(!t) return;
  const parts=(w?w.dataset.meetwa:m.dataset.meetmail).split('|');
  const x=confirmedPairs().find(z=>z.pid===parts[0]); if(!x) return;
  const u=x.a.id===parts[1]?x.a:x.b, o=(u===x.a)?x.b:x.a;
  if(w){ setTimeout(()=>markMeet(u,x.pid,'whatsapp').then(renderMeetups),50); return; }
  const c=contactMap()[u.id]; if(!c||!c.email) return;
  m.disabled=true;
  const ok=await sendEmail(c.email,firstName(u.name),'Your coffee meetup is confirmed ☕',meetText(u,o,x.cafe,x.when));
  if(ok){ await markMeet(u,x.pid,'email'); toast('Email sent to '+firstName(u.name)+'.'); } else toast('Email could not be sent. Check the EmailJS settings.');
  renderMeetups();
});
$('#memberList').addEventListener('click',async e=>{
  const a=e.target.closest('[data-notify]'), b=e.target.closest('[data-email]');
  if(a){ const u=DB.get('users',[]).find(x=>x.id===a.dataset.notify); if(u){ const list=pendingFor(u); setTimeout(()=>markNotified(u,list).then(renderMembers),50); } }
  if(b){
    const u=DB.get('users',[]).find(x=>x.id===b.dataset.email), c=u&&contactMap()[u.id]; if(!u||!c) return;
    b.disabled=true;
    const list=pendingFor(u), ok=await sendEmail(c.email,firstName(u.name),'People are available to meet at Coffee With Stranger',memberMsg(u));
    if(ok){ await markNotified(u,list); toast('Email sent to '+firstName(u.name)+'.'); } else toast('Email could not be sent. Check the EmailJS settings.');
    renderMembers();
  }
});
$('#mailAllBtn').onclick=()=>{ if(!EMAILJS_ON()){ toast('Email sending is not set up yet. See SETUP.md.'); return; } sendPendingEmails(true); };
$('#autoMail').checked=!!lget('autoMail',false);
$('#autoMail').addEventListener('change',()=>{ lset('autoMail',$('#autoMail').checked); if($('#autoMail').checked) sendPendingEmails(true); });
$('#memberSearch').addEventListener('input',()=>renderMembers());
$('#csvBtn').onclick=async()=>{
  const users=DB.get('users',[]);
  const cm={}; (await DB.contactsAll()).forEach(c=>cm[c.id]=c);
  const head=['Name','Age','Gender','Phone','Email','Occupation','Role','Area','Interested in','Likes','Looking for','Wants to meet','Available days and times'];
  const q=v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"';
  const rows=users.map(u=>{ const c=cm[u.id]||{}; return [u.name,u.age,u.gender,c.phone||'',c.email||'',catLabel(u.cat),u.role,u.area,(u.fields||[]).join('; '),(u.likes||[]).join('; '),u.lookGender,(u.wants||[]).map(catLabel).join('; '),slotLabel(u)].map(q).join(','); });
  const blob=new Blob([[head.map(q).join(',')].concat(rows).join('\n')],{type:'text/csv'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='cws-members.csv'; a.click();
};

/* ============ NAV ============ */
$('#menuBtn').onclick=()=>$('#navLinks').classList.toggle('open');
$('#navLinks').addEventListener('click',e=>{ if(e.target.tagName==='A') $('#navLinks').classList.remove('open'); });

/* ============ INIT ============ */
onData=function(){
  try{
    const sel=$('#f_cafe'), keep=sel?sel.value:'';
    renderCafes(); refreshCafeSelect(keep||undefined); buildTimeChips(); updateBell(); checkNewMatches(); checkConfirmed();
    if(adminOn) renderAdmin();
    if($('#matchOv').classList.contains('on')) openMatches();
  }catch(e){ console.error(e); }
};
DB.start(); buildForm(); renderCafes(); updateBell();
$('#calBox').addEventListener('click',e=>{
  const b=e.target.closest('[data-d]'), n=e.target.closest('[data-nav]');
  if(b){ const d=b.dataset.d; if(calSel.has(d)) calSel.delete(d); else calSel.add(d); renderCal(); }
  else if(n){ calM+=parseInt(n.dataset.nav,10); if(calM<0){ calM=11; calY--; } if(calM>11){ calM=0; calY++; } renderCal(); }
});
$('#f_cafe').addEventListener('change',buildTimeChips);
DB.ready.then(()=>{ const me=getMe(), n=newCount(me); if(me&&n) setTimeout(()=>toast('🔔 '+n+' new '+(n>1?'people are':'person is')+' available to meet. Tap My matches.'),1200); lastNew=n; });
</script>
</body>
</html>
