          <input type="text" placeholder="Sharma" id="lname"/>
        </div>
      </div>
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" placeholder="arjun@example.com" id="email"/>
      </div>
      <div class="form-group">
        <label>Phone Number</label>
        <input type="tel" placeholder="+91 98765 43210" id="phone"/>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Age</label>
          <input type="number" placeholder="26" min="18" max="60" id="age"/>
        </div>
        <div class="form-group">
          <label>Profession</label>
          <input type="text" placeholder="Software Engineer" id="profession"/>
        </div>
      </div>
      <div class="form-group">
        <label>Gender</label>
        <div class="gender-opts">
          <div class="gender-opt"><input type="radio" name="gender" id="gm" value="male"/><label for="gm">Male</label></div>
          <div class="gender-opt"><input type="radio" name="gender" id="gf" value="female"/><label for="gf">Female</label></div>
          <div class="gender-opt"><input type="radio" name="gender" id="go" value="other"/><label for="go">Other</label></div>
        </div>
      </div>
      <div class="form-group">
        <label>Preferred Time Slot</label>
        <select id="slot">
          <option>Morning (8 AM – 11 AM)</option>
          <option>Afternoon (12 PM – 3 PM)</option>
          <option>Evening (4 PM – 7 PM)</option>
        </select>
      </div>
      <div class="form-group">
        <label>What brings you here? <span style="color:var(--muted);font-weight:400">(optional)</span></label>
        <textarea placeholder="I want to meet interesting people, expand my circle..." style="height:70px;resize:none;" id="intro"></textarea>
      </div>
      <button class="form-submit" onclick="submitBooking()">Continue to Payment →</button>
    </div>

    <div id="bookingSuccess" class="success-msg" style="display:none">
