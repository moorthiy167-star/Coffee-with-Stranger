<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Coffee With Stranger | Meet Someone New Over Coffee — Bengaluru</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<style>
  :root {
    --espresso: #1a0a00;
    --roast: #3d1f00;
    --caramel: #c47c2b;
    --cream: #f9f3e8;
    --foam: #fdf8f0;
    --steam: #e8dcc8;
    --text: #1a0a00;
    --muted: #6b5240;
    --success: #2d7a4f;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'DM Sans',sans-serif;background:var(--foam);color:var(--text);overflow-x:hidden;}

  /* NAV */
  nav{position:fixed;top:0;width:100%;z-index:100;background:rgba(253,248,240,0.95);backdrop-filter:blur(8px);border-bottom:1px solid var(--steam);padding:0 2rem;}
  .nav-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:64px;}
  .nav-logo{font-family:'Playfair Display',serif;font-size:1.3rem;color:var(--espresso);text-decoration:none;display:flex;align-items:center;gap:8px;}
  .nav-logo span{font-size:1.4rem;}
  .nav-links{display:flex;gap:1.5rem;align-items:center;}
  .nav-links a{text-decoration:none;color:var(--muted);font-size:0.9rem;font-weight:500;transition:color 0.2s;}
  .nav-links a:hover{color:var(--caramel);}
  .nav-cta{background:var(--espresso);color:var(--cream)!important;padding:8px 20px;border-radius:50px;font-size:0.85rem!important;}
  .nav-cta:hover{background:var(--roast)!important;color:var(--cream)!important;}

  /* HERO */
  .hero{min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:6rem 2rem 4rem;position:relative;overflow:hidden;background:linear-gradient(160deg,#1a0a00 0%,#3d1f00 40%,#6b3a1a 70%,#c47c2b 100%);}
  .hero-bg{position:absolute;inset:0;opacity:0.06;background-image:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");}
  .hero-content{position:relative;z-index:1;max-width:700px;}
  .hero-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(196,124,43,0.3);border:1px solid rgba(196,124,43,0.5);color:#f5d49a;padding:6px 16px;border-radius:50px;font-size:0.8rem;font-weight:500;letter-spacing:0.5px;margin-bottom:1.5rem;}
  .hero h1{font-family:'Playfair Display',serif;font-size:clamp(2.5rem,6vw,4.5rem);color:#fdf8f0;line-height:1.15;margin-bottom:1.5rem;}
  .hero h1 em{color:#f5c267;font-style:italic;}
  .hero p{font-size:1.15rem;color:#c8b49a;max-width:500px;margin:0 auto 2.5rem;line-height:1.7;}
  .hero-buttons{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;}
  .btn-primary{background:var(--caramel);color:#fff;padding:14px 32px;border-radius:50px;text-decoration:none;font-weight:600;font-size:1rem;border:none;cursor:pointer;transition:all 0.2s;display:inline-block;}
  .btn-primary:hover{background:#a8661f;transform:translateY(-1px);}
  .btn-outline{background:transparent;color:#fdf8f0;padding:14px 32px;border-radius:50px;text-decoration:none;font-weight:500;font-size:1rem;border:1.5px solid rgba(253,248,240,0.4);cursor:pointer;transition:all 0.2s;display:inline-block;}
  .btn-outline:hover{border-color:#fdf8f0;background:rgba(253,248,240,0.08);}
  .hero-stats{display:flex;gap:2.5rem;justify-content:center;margin-top:3.5rem;padding-top:2.5rem;border-top:1px solid rgba(253,248,240,0.15);}
  .stat{text-align:center;}
  .stat-num{font-family:'Playfair Display',serif;font-size:1.8rem;color:#f5c267;font-weight:700;}
  .stat-label{font-size:0.8rem;color:#c8b49a;margin-top:2px;}

  /* SECTIONS */
  section{padding:5rem 2rem;}
  .container{max-width:1100px;margin:0 auto;}
  .section-tag{display:inline-block;background:var(--steam);color:var(--muted);font-size:0.75rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;padding:4px 14px;border-radius:50px;margin-bottom:1rem;}
  .section-title{font-family:'Playfair Display',serif;font-size:clamp(1.8rem,4vw,2.8rem);color:var(--espresso);margin-bottom:1rem;line-height:1.25;}
  .section-sub{color:var(--muted);font-size:1.05rem;line-height:1.7;max-width:550px;}

  /* FOUNDER */
  .founder-section{background:var(--cream);}
  .founder-card{display:flex;gap:3rem;align-items:center;background:#fff;border-radius:24px;padding:3rem;border:1px solid var(--steam);box-shadow:0 4px 24px rgba(26,10,0,0.06);}
  .founder-img{width:180px;height:180px;border-radius:50%;object-fit:cover;flex-shrink:0;background:linear-gradient(135deg,var(--caramel),var(--roast));display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:4rem;color:#fff;}
  .founder-info h3{font-family:'Playfair Display',serif;font-size:1.8rem;color:var(--espresso);margin-bottom:0.3rem;}
  .founder-role{color:var(--caramel);font-weight:600;font-size:0.9rem;letter-spacing:0.5px;text-transform:uppercase;margin-bottom:1rem;}
  .founder-bio{color:var(--muted);line-height:1.8;margin-bottom:1.5rem;}
  .founder-links{display:flex;gap:1rem;}
  .founder-link{display:inline-flex;align-items:center;gap:6px;color:var(--espresso);text-decoration:none;font-size:0.85rem;font-weight:500;border:1px solid var(--steam);padding:6px 14px;border-radius:50px;transition:all 0.2s;}
  .founder-link:hover{background:var(--espresso);color:var(--cream);border-color:var(--espresso);}
  .founder-mission{margin-top:3rem;background:var(--espresso);border-radius:20px;padding:2.5rem;color:var(--cream);}
  .founder-mission h4{font-family:'Playfair Display',serif;font-size:1.4rem;margin-bottom:1rem;color:#f5c267;}
  .founder-mission p{color:#c8b49a;line-height:1.8;}

  /* HOW IT WORKS */
  .how-section{background:var(--foam);}
  .steps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.5rem;margin-top:3rem;}
  .step-card{background:#fff;border-radius:20px;padding:2rem;border:1px solid var(--steam);position:relative;}
  .step-num{font-family:'Playfair Display',serif;font-size:3rem;color:var(--steam);font-weight:700;line-height:1;margin-bottom:1rem;}
  .step-icon{font-size:1.8rem;margin-bottom:0.8rem;}
  .step-card h4{font-weight:600;color:var(--espresso);margin-bottom:0.5rem;}
  .step-card p{color:var(--muted);font-size:0.9rem;line-height:1.6;}

  /* SHOPS + QR */
  .shops-section{background:var(--cream);}
  .shops-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:2rem;margin-top:3rem;}
  .shop-card{background:#fff;border-radius:20px;overflow:hidden;border:1px solid var(--steam);transition:box-shadow 0.2s;}
  .shop-card:hover{box-shadow:0 8px 32px rgba(26,10,0,0.1);}
  .shop-header{padding:1.5rem;background:linear-gradient(135deg,var(--espresso),var(--roast));color:#fff;position:relative;}
  .shop-header h3{font-family:'Playfair Display',serif;font-size:1.3rem;margin-bottom:0.3rem;}
  .shop-header p{font-size:0.85rem;opacity:0.75;}
  .shop-badge{position:absolute;top:1rem;right:1rem;background:var(--caramel);color:#fff;font-size:0.7rem;font-weight:600;padding:3px 10px;border-radius:50px;letter-spacing:0.5px;}
  .shop-body{padding:1.5rem;display:flex;gap:1.5rem;align-items:flex-start;}
  .shop-qr{flex-shrink:0;text-align:center;}
  .shop-qr canvas, .shop-qr img{border-radius:8px;border:2px solid var(--steam);}
  .shop-qr p{font-size:0.7rem;color:var(--muted);margin-top:6px;}
  .shop-details{flex:1;}
  .shop-detail{display:flex;align-items:center;gap:8px;margin-bottom:0.7rem;font-size:0.88rem;color:var(--muted);}
  .shop-detail strong{color:var(--espresso);}
  .shop-detail-icon{font-size:1rem;width:20px;text-align:center;}
  .shop-slots{display:flex;gap:6px;flex-wrap:wrap;margin-top:1rem;}
  .slot-pill{font-size:0.75rem;padding:4px 12px;border-radius:50px;border:1px solid var(--steam);color:var(--muted);background:var(--foam);}
  .slot-pill.available{background:#e8f5ee;border-color:#a8d5b8;color:#2d7a4f;}
  .shop-footer{padding:1rem 1.5rem;border-top:1px solid var(--steam);display:flex;justify-content:space-between;align-items:center;}
  .book-btn{background:var(--espresso);color:#fff;border:none;padding:8px 20px;border-radius:50px;font-size:0.85rem;font-weight:600;cursor:pointer;transition:all 0.2s;}
  .book-btn:hover{background:var(--caramel);}
  .shop-price{font-family:'Playfair Display',serif;font-size:1.2rem;color:var(--espresso);font-weight:700;}

  /* QR REGISTER MODAL */
  .modal-overlay{display:none;position:fixed;inset:0;background:rgba(26,10,0,0.7);z-index:200;align-items:center;justify-content:center;padding:1rem;}
  .modal-overlay.active{display:flex;}
  .modal{background:#fff;border-radius:24px;padding:2.5rem;max-width:480px;width:100%;position:relative;max-height:90vh;overflow-y:auto;}
  .modal-close{position:absolute;top:1rem;right:1rem;background:var(--steam);border:none;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:1.2rem;display:flex;align-items:center;justify-content:center;color:var(--muted);}
  .modal h3{font-family:'Playfair Display',serif;font-size:1.6rem;color:var(--espresso);margin-bottom:0.3rem;}
  .modal .shop-name-badge{background:var(--foam);border:1px solid var(--steam);color:var(--caramel);font-weight:600;font-size:0.82rem;padding:4px 12px;border-radius:50px;display:inline-block;margin-bottom:1.2rem;}
  .form-group{margin-bottom:1.2rem;}
  .form-group label{display:block;font-size:0.85rem;font-weight:600;color:var(--espresso);margin-bottom:0.4rem;}
  .form-group input, .form-group select, .form-group textarea{width:100%;padding:10px 14px;border:1.5px solid var(--steam);border-radius:10px;font-family:'DM Sans',sans-serif;font-size:0.9rem;color:var(--text);background:var(--foam);outline:none;transition:border-color 0.2s;}
  .form-group input:focus, .form-group select:focus{border-color:var(--caramel);}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
  .gender-opts{display:flex;gap:0.8rem;}
  .gender-opt{flex:1;}
  .gender-opt input{display:none;}
  .gender-opt label{display:block;text-align:center;padding:8px;border:1.5px solid var(--steam);border-radius:10px;cursor:pointer;font-size:0.85rem;color:var(--muted);transition:all 0.2s;}
  .gender-opt input:checked + label{border-color:var(--caramel);background:#fdf3e4;color:var(--caramel);font-weight:600;}
  .form-submit{width:100%;background:var(--espresso);color:#fff;border:none;padding:14px;border-radius:50px;font-size:1rem;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;transition:background 0.2s;margin-top:0.5rem;}
  .form-submit:hover{background:var(--caramel);}
  .success-msg{text-align:center;padding:1.5rem 0;}
  .success-icon{font-size:3rem;margin-bottom:1rem;}
  .success-msg h4{font-family:'Playfair Display',serif;font-size:1.4rem;color:var(--success);margin-bottom:0.5rem;}
  .success-msg p{color:var(--muted);font-size:0.9rem;}

  /* PAYMENT */
  .payment-section{background:var(--foam);}
  .payment-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:3rem;align-items:start;margin-top:3rem;}
  .plan-card{background:#fff;border-radius:20px;padding:2rem;border:2px solid var(--caramel);position:relative;overflow:hidden;}
  .plan-card::before{content:'Most Popular';position:absolute;top:1.2rem;right:-1.5rem;background:var(--caramel);color:#fff;font-size:0.7rem;font-weight:700;padding:4px 20px;transform:rotate(12deg);letter-spacing:0.5px;}
  .plan-price{font-family:'Playfair Display',serif;font-size:3rem;color:var(--espresso);font-weight:700;line-height:1;}
  .plan-price sup{font-size:1.2rem;vertical-align:top;margin-top:0.5rem;display:inline-block;}
  .plan-period{color:var(--muted);font-size:0.9rem;margin-top:0.5rem;}
  .plan-features{list-style:none;margin:1.5rem 0;display:flex;flex-direction:column;gap:0.8rem;}
  .plan-features li{display:flex;align-items:center;gap:8px;font-size:0.9rem;color:var(--muted);}
  .plan-features li::before{content:'✓';color:var(--success);font-weight:700;font-size:1rem;}
  .payment-form-card{background:#fff;border-radius:20px;padding:2rem;border:1px solid var(--steam);}
  .payment-form-card h4{font-family:'Playfair Display',serif;font-size:1.3rem;color:var(--espresso);margin-bottom:1.5rem;}
  .payment-methods{display:flex;gap:0.8rem;margin-bottom:1.5rem;flex-wrap:wrap;}
  .pay-method{border:1.5px solid var(--steam);border-radius:10px;padding:8px 16px;cursor:pointer;font-size:0.85rem;color:var(--muted);transition:all 0.2s;background:var(--foam);}
  .pay-method.selected{border-color:var(--caramel);background:#fdf3e4;color:var(--caramel);font-weight:600;}
  .card-row{display:grid;grid-template-columns:2fr 1fr;gap:0.8rem;}
  .secure-note{display:flex;align-items:center;gap:6px;font-size:0.78rem;color:var(--muted);margin-top:1rem;}
  .secure-note::before{content:'🔒';font-size:0.9rem;}
  .upi-section, .netbanking-section{display:none;}
  .upi-section.active, .netbanking-section.active{display:block;}
  .banks-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0.5rem;margin-top:0.8rem;}
  .bank-btn{border:1.5px solid var(--steam);border-radius:8px;padding:8px 6px;text-align:center;cursor:pointer;font-size:0.72rem;color:var(--muted);background:var(--foam);transition:all 0.2s;}
  .bank-btn:hover{border-color:var(--caramel);}

  /* TESTIMONIALS */
  .testimonials-section{background:var(--cream);}
  .testimonials-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:1.5rem;margin-top:3rem;}
  .testimonial-card{background:#fff;border-radius:20px;padding:1.8rem;border:1px solid var(--steam);}
  .stars{color:var(--caramel);font-size:0.9rem;margin-bottom:1rem;}
  .testimonial-text{color:var(--muted);font-size:0.93rem;line-height:1.7;margin-bottom:1.2rem;font-style:italic;}
  .testimonial-author{display:flex;align-items:center;gap:10px;}
  .author-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--caramel),var(--roast));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600;font-size:0.85rem;flex-shrink:0;}
  .author-name{font-weight:600;font-size:0.88rem;color:var(--espresso);}
  .author-meta{font-size:0.78rem;color:var(--muted);}

  /* LIST YOUR CAFE */
  .list-section{background:var(--espresso);}
  .list-section .section-tag{background:rgba(196,124,43,0.3);color:#f5c267;}
  .list-section .section-title{color:#fdf8f0;}
  .list-section .section-sub{color:#c8b49a;}
  .list-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:3rem;align-items:start;margin-top:3rem;}
  .list-benefits{display:flex;flex-direction:column;gap:1rem;}
  .list-benefit{display:flex;align-items:flex-start;gap:1rem;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:1.2rem;}
  .list-benefit-icon{font-size:1.6rem;flex-shrink:0;}
  .list-benefit h4{color:#f5c267;font-weight:600;font-size:0.95rem;margin-bottom:0.2rem;}
  .list-benefit p{color:#c8b49a;font-size:0.85rem;line-height:1.5;}
  .list-form-card{background:#fff;border-radius:20px;padding:2rem;}
  .list-form-card h4{font-family:'Playfair Display',serif;font-size:1.3rem;color:var(--espresso);margin-bottom:0.3rem;}
  .list-form-card p{color:var(--muted);font-size:0.85rem;margin-bottom:1.5rem;}
  @media(max-width:768px){.list-grid{grid-template-columns:1fr;}}

  /* SAFETY */
  .safety-section{background:var(--foam);}
  .safety-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;margin-top:3rem;}
  .safety-card{background:#fff;border-radius:20px;padding:1.8rem;border:1px solid var(--steam);display:flex;gap:1rem;}
  .safety-icon{width:44px;height:44px;border-radius:12px;background:var(--cream);display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;}
  .safety-text h4{font-weight:600;color:var(--espresso);margin-bottom:0.3rem;font-size:0.95rem;}
  .safety-text p{color:var(--muted);font-size:0.85rem;line-height:1.6;}

  /* FAQ */
  .faq-section{background:var(--cream);}
  .faq-list{margin-top:3rem;max-width:720px;}
  .faq-item{border:1px solid var(--steam);border-radius:14px;margin-bottom:0.8rem;overflow:hidden;background:#fff;}
  .faq-q{padding:1.2rem 1.5rem;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-weight:500;color:var(--espresso);}
  .faq-q::after{content:'+';font-size:1.4rem;color:var(--caramel);transition:transform 0.2s;}
  .faq-item.open .faq-q::after{transform:rotate(45deg);}
  .faq-a{max-height:0;overflow:hidden;transition:max-height 0.3s ease;padding:0 1.5rem;color:var(--muted);font-size:0.9rem;line-height:1.7;}
  .faq-item.open .faq-a{max-height:200px;padding:0 1.5rem 1.2rem;}

  /* FOOTER */
  footer{background:var(--espresso);color:var(--cream);padding:3rem 2rem 2rem;}
  .footer-inner{max-width:1100px;margin:0 auto;}
  .footer-top{display:grid;grid-template-columns:2fr 1fr 1fr;gap:3rem;padding-bottom:2rem;border-bottom:1px solid rgba(253,248,240,0.1);}
  .footer-brand h3{font-family:'Playfair Display',serif;font-size:1.4rem;margin-bottom:0.8rem;}
  .footer-brand p{color:#c8b49a;font-size:0.88rem;line-height:1.7;}
  .footer-col h5{font-weight:600;margin-bottom:1rem;color:#f5c267;font-size:0.85rem;text-transform:uppercase;letter-spacing:0.5px;}
  .footer-col a{display:block;color:#c8b49a;text-decoration:none;font-size:0.88rem;margin-bottom:0.6rem;transition:color 0.2s;}
  .footer-col a:hover{color:var(--caramel);}
  .footer-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:1.5rem;font-size:0.82rem;color:#c8b49a;flex-wrap:wrap;gap:1rem;}
  .footer-made{display:flex;align-items:center;gap:6px;}

  /* MOBILE */
  @media(max-width:768px){
    .nav-links{display:none;}
    .founder-card{flex-direction:column;text-align:center;}
    .payment-grid{grid-template-columns:1fr;}
    .footer-top{grid-template-columns:1fr;}
    .hero-stats{gap:1.5rem;}
    .shop-body{flex-direction:column;}
  }
  @media(max-width:480px){
    .form-row{grid-template-columns:1fr;}
    .hero h1{font-size:2rem;}
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-inner">
    <a href="#" class="nav-logo"><span>☕</span> Coffee With Stranger</a>
    <div class="nav-links">
      <a href="#how">How It Works</a>
      <a href="#cafes">Cafés & QR</a>
      <a href="#founder">About</a>
      <a href="#list-cafe">List Your Café</a>
      <a href="#payment" class="nav-cta">Book Now</a>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    <div class="hero-badge">☕ Bengaluru's Newest Social Experience — Launching Now</div>
    <h1>One Coffee.<br/><em>One Stranger.</em><br/>Endless Possibilities.</h1>
    <p>Break the doom-scroll. Meet a real human being over a cup of coffee. No algorithms, no swipes — just two people and a real conversation.</p>
    <div class="hero-buttons">
      <a href="#cafes" class="btn-primary">Find a Venue & Register</a>
      <a href="#how" class="btn-outline">How It Works</a>
    </div>
    <div class="hero-stats">
      <div class="stat"><div class="stat-num">🚀</div><div class="stat-label">Launching 2025</div></div>
      <div class="stat"><div class="stat-num">BLR</div><div class="stat-label">Starting in Bengaluru</div></div>
