<script>
// Generate QR codes for each café
const cafes = [
  { id: 'qr1', name: 'Indiranagar Café', url: 'https://moorthiy167-star.github.io/Coffee-with-Stranger/?cafe=indiranagar&register=1' },
  { id: 'qr2', name: 'Koramangala Café', url: 'https://moorthiy167-star.github.io/Coffee-with-Stranger/?cafe=koramangala&register=1' },
  { id: 'qr3', name: 'Whitefield Café', url: 'https://moorthiy167-star.github.io/Coffee-with-Stranger/?cafe=whitefield&register=1' }
];

window.addEventListener('load', () => {
  cafes.forEach(c => {
    new QRCode(document.getElementById(c.id), {
      text: c.url,
      width: 100,
      height: 100,
      colorDark: '#1a0a00',
      colorLight: '#fdf8f0',
      correctLevel: QRCode.CorrectLevel.M
    });
  });

  // Check URL for café-specific registration
  const params = new URLSearchParams(window.location.search);
  if(params.get('register') === '1') {
    const cafeParam = params.get('cafe');
    const cafeMap = { indiranagar: 'Indiranagar Café', koramangala: 'Koramangala Café', whitefield: 'Whitefield Café' };
    if(cafeParam && cafeMap[cafeParam]) {
      setTimeout(() => openBooking(cafeMap[cafeParam]), 500);
    }
  }
});

let currentShop = '';
function openBooking(shop) {
  currentShop = shop;
  document.getElementById('modalShopName').textContent = shop;
  document.getElementById('bookingFormWrap').style.display = 'block';
  document.getElementById('bookingSuccess').style.display = 'none';
  document.getElementById('bookingModal').classList.add('active');
  document.body.style.overflow = 'hidden';
}
function closeBooking() {
  document.getElementById('bookingModal').classList.remove('active');
  document.body.style.overflow = '';
}
document.getElementById('bookingModal').addEventListener('click', function(e) {
  if(e.target === this) closeBooking();
});

function submitBooking() {
  const fname = document.getElementById('fname').value.trim();
  const email = document.getElementById('email').value.trim();
  const phone = document.getElementById('phone').value.trim();
  if(!fname || !email || !phone) {
    alert('Please fill in your name, email, and phone to continue.');
    return;
  }
  document.getElementById('bookingFormWrap').style.display = 'none';
  document.getElementById('bookingSuccess').style.display = 'block';
  document.getElementById('successText').innerHTML = `Your profile for <strong>${currentShop}</strong> has been created! We'll match you and send confirmation to <strong>${email}</strong> before your slot.`;
  // Redirect to payment after short delay
  setTimeout(() => {
    closeBooking();
    document.getElementById('payment').scrollIntoView({ behavior: 'smooth' });
  }, 2500);
}

function selectPayMethod(el, method) {}
function formatCard(input) {}

function processPayment() {
  const name  = document.getElementById('pay_name').value.trim();
  const email = document.getElementById('pay_email').value.trim();
  const phone = document.getElementById('pay_phone').value.trim();

  if(!name || !email || !phone) {
    alert('Please fill in your name, email, and phone number to proceed.');
    return;
  }

  const options = {
    key: 'rzp_test_SpiQKYMzuptIYL',
    amount: 34900, // ₹349 in paise
    currency: 'INR',
    name: 'Coffee With Stranger',
    description: 'Stranger Meetup Session',
    image: 'https://moorthiy167-star.github.io/Coffee-with-Stranger/favicon.ico',
    prefill: {
      name:  name,
      email: email,
      contact: phone
    },
    notes: {
      cafe: currentShop || 'Not selected'
    },
    theme: {
      color: '#1a0a00'
    },
    handler: function(response) {
      document.getElementById('pay_success').style.display = 'block';
      document.querySelector('#paymentForm .form-submit').style.display = 'none';
      console.log('Payment ID:', response.razorpay_payment_id);
    },
    modal: {
      ondismiss: function() {
        console.log('Payment popup closed');
      }
    }
  };

  const rzp = new Razorpay(options);
  rzp.on('payment.failed', function(response) {
    alert('Payment failed: ' + response.error.description + '\nPlease try again.');
  });
  rzp.open();
}

function submitCafeListing() {
  const name = document.getElementById('cafeName').value.trim();
  const phone = document.getElementById('ownerPhone').value.trim();
  const email = document.getElementById('ownerEmail').value.trim();
  if(!name || (!phone && !email)) {
    alert('Please fill in your café name and at least one contact detail.');
    return;
  }
  document.getElementById('listFormWrap').style.display = 'none';
  document.getElementById('listSuccess').style.display = 'block';
  document.getElementById('listConfirmContact').textContent = email || phone;
}

function toggleFaq(el) {
  const item = el.parentElement;
  const wasOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
  if(!wasOpen) item.classList.add('open');
}
</script>
</body>
</html>
